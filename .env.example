# Runtime environment: development | production
NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (required in production)
MONGODB_URI=

# Express session signing secret (required in production, >= 16 characters)
SESSION_SECRET=

# Optional initial administrator seed credentials
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional sample student seed password (development only)
SEED_STUDENT_PASSWORD=

# Application URL (automatically injected by Google AI Studio Hosting)
APP_URL=
