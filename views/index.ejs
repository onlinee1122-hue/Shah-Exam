                <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
              </div>
              <div class="nav-group-items">
                ${g.items
                  .map(
                    (it) => `
                  <button type="button" class="nav-link ${this.currentView === it.view ? 'active' : ''}" data-view="${this.esc(it.view)}">
                    <i class="fa-solid ${this.esc(it.icon)}"></i>
                    <span>${this.esc(it.text)}</span>
                    ${it.badge > 0 ? `<span class="nav-badge">${it.badge}</span>` : ''}
                  </button>`
                  )
                  .join('')}
              </div>
