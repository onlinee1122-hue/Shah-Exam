<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title><%= appName %> — Student & Admin Management Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" crossorigin="anonymous"></script>
  <style>
    :root {
      --theme-dark: #0F5298;
      --theme-light: #1665B5;
      --bg-gray: #F2F5F7;
      --text-dark: #333333;
      --text-muted: #777777;

      --green: #27AE60;
      --orange: #F39C12;
      --teal: #33B89E;
      --red: #D93025;

      --white: #FFFFFF;
      --border-color: #E5E9EF;

      --shadow: 0 4px 15px rgba(0,0,0,0.10);
      --radius: 12px;

      --sidebar-width: 260px;
      --header-height: 70px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 14px;
      line-height: 1.55;
      color: var(--text-dark);
      background: var(--bg-gray);
      min-height: 100vh;
      overflow-x: hidden;
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: 14px;
    }

    a {
      color: var(--theme-light);
      text-decoration: none;
    }

    .hidden {
      display: none !important;
    }

    /* ---------------- AUTHENTICATION SCREEN ---------------- */
    .auth-screen {
      min-height: 100vh;
      background: linear-gradient(135deg, var(--theme-dark) 0%, #0A3A6D 55%, var(--theme-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    .auth-card {
      width: 100%;
      max-width: 480px;
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }

    .auth-brand {
      background: linear-gradient(135deg, var(--theme-dark), var(--theme-light));
      color: var(--white);
      padding: 26px 28px 22px;
      text-align: center;
    }

    .auth-brand-icon {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.16);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 10px;
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .auth-brand h1 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.2px;
    }

    .auth-brand p {
      font-size: 12px;
      opacity: 0.88;
      margin-top: 2px;
    }

    .auth-tabs {
      display: flex;
      border-bottom: 1px solid var(--border-color);
      background: #FAFCFE;
    }

    .auth-tab-btn {
      flex: 1;
      padding: 13px 10px;
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      font-weight: 600;
      font-size: 13px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .auth-tab-btn.active {
      color: var(--theme-dark);
      border-bottom-color: var(--orange);
      background: var(--white);
    }

    .auth-body {
      padding: 24px 28px 28px;
    }

    .setup-banner {
      background: #FFF8EB;
      border: 1px solid #F7D794;
      border-left: 4px solid var(--orange);
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 12px;
      color: #6B4800;
      margin-bottom: 16px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }

    /* ---------------- FORM CONTROLS & BUTTONS ---------------- */
    .form-group {
      margin-bottom: 15px;
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-dark);
      margin-bottom: 5px;
    }

    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-wrap i.input-icon {
      position: absolute;
      left: 12px;
      color: var(--text-muted);
      font-size: 13px;
      pointer-events: none;
    }

    .form-control {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: var(--white);
      color: var(--text-dark);
      font-size: 13.5px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap .form-control {
      padding-left: 36px;
    }

    .input-wrap .toggle-pw {
      position: absolute;
      right: 10px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      padding: 4px 6px;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--theme-light);
      box-shadow: 0 0 0 3px rgba(22, 101, 181, 0.12);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 90px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .form-inline-between {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 16px;
      font-size: 12.5px;
    }

    .checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 12.5px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 8px;
      border: 1px solid transparent;
      font-weight: 600;
      font-size: 13.5px;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .btn-block {
      width: 100%;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
      border-radius: 6px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--theme-dark), var(--theme-light));
      color: var(--white);
    }
    .btn-primary:hover:not(:disabled) {
      filter: brightness(1.07);
      transform: translateY(-1px);
    }

    .btn-success {
      background: var(--green);
      color: var(--white);
    }
    .btn-orange {
      background: var(--orange);
      color: var(--white);
    }
    .btn-teal {
      background: var(--teal);
      color: var(--white);
    }
    .btn-danger {
      background: var(--red);
      color: var(--white);
    }
    .btn-outline {
      background: var(--white);
      border-color: var(--border-color);
      color: var(--text-dark);
    }
    .btn-outline:hover:not(:disabled) {
      border-color: var(--theme-light);
      color: var(--theme-dark);
      background: #F7FAFD;
    }

    /* ---------------- PORTAL LAYOUT SHELL ---------------- */
    .portal-shell {
      min-height: 100vh;
      display: flex;
      background: var(--bg-gray);
    }

    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 25, 47, 0.52);
      z-index: 998;
    }
    .sidebar-backdrop.open {
      display: block;
    }

    .sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, var(--theme-dark) 0%, #0B3E75 100%);
      color: var(--white);
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 999;
      display: flex;
      flex-direction: column;
      transition: transform 0.26s ease, width 0.26s ease;
      box-shadow: 4px 0 18px rgba(0, 0, 0, 0.12);
    }

    .sidebar-header {
      height: var(--header-height);
      padding: 0 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .sidebar-logo {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.16);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: var(--white);
      flex-shrink: 0;
    }

    .sidebar-title {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.2px;
      white-space: nowrap;
      overflow: hidden;
    }

    .sidebar-subtitle {
      font-size: 11px;
      opacity: 0.78;
      display: block;
      font-weight: 400;
    }

    .sidebar-nav {
      flex: 1;
      overflow-y: auto;
      padding: 14px 0 24px;
    }

    .nav-group-label {
      padding: 12px 20px 6px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: rgba(255, 255, 255, 0.58);
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .nav-group-items {
      display: flex;
      flex-direction: column;
    }
    .nav-group-items.collapsed {
      display: none;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 20px;
      color: rgba(255, 255, 255, 0.86);
      font-size: 13.5px;
      font-weight: 500;
      border-left: 4px solid transparent;
      cursor: pointer;
      transition: all 0.18s ease;
      background: transparent;
      border-top: none;
      border-right: none;
      border-bottom: none;
      width: 100%;
      text-align: left;
    }

    .nav-link i {
      width: 18px;
      text-align: center;
      font-size: 14px;
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.09);
      color: var(--white);
    }

    .nav-link.active {
      background: rgba(22, 101, 181, 0.65);
      border-left-color: var(--orange);
      color: var(--white);
      font-weight: 600;
    }

    .nav-badge {
      margin-left: auto;
      background: var(--orange);
      color: var(--white);
      font-size: 11px;
      font-weight: 600;
      padding: 1px 7px;
      border-radius: 10px;
    }

    .sidebar-footer {
      padding: 14px 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 12px;
      color: rgba(255, 255, 255, 0.78);
    }

    /* Desktop collapsed sidebar */
    body.sidebar-collapsed .sidebar {
      width: 74px;
    }
    body.sidebar-collapsed .sidebar-title,
    body.sidebar-collapsed .nav-link span,
    body.sidebar-collapsed .nav-badge,
    body.sidebar-collapsed .nav-group-label,
    body.sidebar-collapsed .sidebar-footer span {
      display: none;
    }
    body.sidebar-collapsed .main-wrapper {
      margin-left: 74px;
      width: calc(100% - 74px);
    }

    .main-wrapper {
      margin-left: var(--sidebar-width);
      width: calc(100% - var(--sidebar-width));
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: margin-left 0.26s ease, width 0.26s ease;
    }

    /* ---------------- TOP WHITE HEADER ---------------- */
    .top-header {
      height: var(--header-height);
      background: var(--white);
      border-bottom: 1px solid var(--border-color);
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .hamburger-btn {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--white);
      color: var(--theme-dark);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    .header-app-name {
      font-weight: 700;
      font-size: 17px;
      color: var(--theme-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 13px;
      border-radius: 999px;
      color: var(--white);
      font-size: 12px;
      font-weight: 600;
      border: none;
    }

    .pill-green {
      background: linear-gradient(135deg, #219653, var(--green));
    }
    .pill-orange {
      background: linear-gradient(135deg, #E67E22, var(--orange));
    }
    .pill-teal {
      background: linear-gradient(135deg, #279B84, var(--teal));
      cursor: pointer;
    }
    .pill-teal:hover {
      filter: brightness(1.06);
    }

    .icon-btn {
      position: relative;
      width: 38px;
      height: 38px;
      border-radius: 9px;
      border: 1px solid var(--border-color);
      background: var(--white);
      color: var(--text-dark);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .icon-btn:hover {
      background: var(--bg-gray);
      color: var(--theme-dark);
    }

    .icon-dot {
      position: absolute;
      top: -4px;
      right: -4px;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      border-radius: 999px;
      background: var(--red);
      color: var(--white);
      font-size: 10px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .header-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--theme-light);
      cursor: pointer;
      background: var(--theme-dark);
      color: var(--white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      overflow: hidden;
    }
    .header-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ---------------- SUBHEADER & BREADCRUMBS ---------------- */
    .subheader {
      background: linear-gradient(90deg, var(--theme-dark) 0%, var(--theme-light) 100%);
      color: var(--white);
      padding: 18px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .subheader-left h1 {
      font-size: 24px;
      font-weight: 700;
      line-height: 1.25;
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      opacity: 0.9;
      margin-bottom: 4px;
    }

    /* ---------------- CONTENT AREA & CARDS ---------------- */
    .content-area {
      padding: 24px;
      flex: 1;
      max-width: 1480px;
      width: 100%;
      margin: 0 auto;
    }

    .card {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid var(--border-color);
      padding: 20px;
      margin-bottom: 20px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
      flex-wrap: wrap;
    }

    .card-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--theme-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 20px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .grid-dashboard-split {
      display: grid;
      grid-template-columns: 340px minmax(0, 1fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    /* Gradient Stat Cards */
    .stat-card {
      border-radius: var(--radius);
      padding: 20px;
      color: var(--white);
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      position: relative;
      overflow: hidden;
    }

    .stat-card.grad-blue {
      background: linear-gradient(135deg, var(--theme-dark), var(--theme-light));
    }
    .stat-card.grad-green {
      background: linear-gradient(135deg, #1E874B, var(--green));
    }
    .stat-card.grad-orange {
      background: linear-gradient(135deg, #D9820B, var(--orange));
    }
    .stat-card.grad-teal {
      background: linear-gradient(135deg, #218F79, var(--teal));
    }

    .stat-card-label {
      font-size: 12px;
      opacity: 0.9;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .stat-card-value {
      font-size: 26px;
      font-weight: 700;
      margin: 4px 0 2px;
    }
    .stat-card-sub {
      font-size: 12px;
      opacity: 0.88;
    }
    .stat-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    /* White Metric Mini-Cards */
    .kpi-card {
      background: var(--white);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .kpi-icon {
      width: 46px;
      height: 46px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: var(--white);
      flex-shrink: 0;
    }

    /* Profile Card */
    .profile-summary-card {
      text-align: center;
    }
    .profile-avatar-lg {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      margin: 0 auto 12px;
      border: 3px solid var(--theme-light);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--theme-dark);
      color: var(--white);
      font-size: 30px;
      font-weight: 700;
    }
    .profile-avatar-lg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .profile-meta-list {
      text-align: left;
      margin-top: 14px;
      border-top: 1px solid var(--border-color);
      padding-top: 12px;
      font-size: 13px;
    }
    .profile-meta-item {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px dashed var(--border-color);
      gap: 8px;
    }
    .profile-meta-item span:first-child {
      color: var(--text-muted);
    }

    /* ---------------- TABLES & BADGES ---------------- */
    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    th, td {
      padding: 11px 12px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      font-size: 13px;
      vertical-align: middle;
    }

    th {
      background: #F7FAFC;
      color: var(--theme-dark);
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    tr:hover td {
      background: #FAFCFE;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 600;
    }
    .badge-green { background: #E7F7EE; color: #197B42; }
    .badge-orange { background: #FEF3DF; color: #B86E00; }
    .badge-blue { background: #E6F0FA; color: var(--theme-dark); }
    .badge-red { background: #FDECEA; color: var(--red); }
    .badge-teal { background: #E4F7F3; color: #1A7F6A; }
    .badge-muted { background: #EEF1F5; color: var(--text-muted); }

    /* Toolbar & Filters */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .toolbar-filters {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      flex: 1;
    }

    /* Charts */
    .chart-box {
      position: relative;
      height: 280px;
      width: 100%;
    }

    /* Progress bar */
    .progress-track {
      height: 8px;
      background: var(--border-color);
      border-radius: 999px;
      overflow: hidden;
      margin-top: 6px;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--theme-dark), var(--teal));
      border-radius: 999px;
    }

    /* List items */
    .feed-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 11px 0;
      border-bottom: 1px solid var(--border-color);
    }
    .feed-item:last-child {
      border-bottom: none;
    }
    .feed-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: #EBF3FC;
      color: var(--theme-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Exam taking interface */
    .exam-timer-bar {
      background: var(--theme-dark);
      color: var(--white);
      padding: 14px 20px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }
    .exam-question-card {
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 18px;
      margin-bottom: 16px;
      background: #FCFDFE;
    }
    .option-choice {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      margin-top: 8px;
      cursor: pointer;
      background: var(--white);
      transition: border-color 0.15s, background 0.15s;
    }
    .option-choice:hover {
      border-color: var(--theme-light);
      background: #F4F9FF;
    }

    /* ---------------- MODALS & TOASTS ---------------- */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 32, 58, 0.58);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-box {
      width: 100%;
      max-width: 640px;
      max-height: 90vh;
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .modal-box.modal-lg {
      max-width: 820px;
    }
    .modal-header {
      background: var(--theme-dark);
      color: var(--white);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .modal-header h3 {
      font-size: 16px;
      font-weight: 600;
    }
    .modal-close {
      background: transparent;
      border: none;
      color: var(--white);
      font-size: 18px;
      cursor: pointer;
    }
    .modal-body {
      padding: 20px;
      overflow-y: auto;
    }

    .toast-stack {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 3000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 360px;
      width: calc(100% - 40px);
    }
    .toast {
      background: var(--white);
      border-radius: 10px;
      padding: 13px 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
      border-left: 4px solid var(--theme-light);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      animation: slideIn 0.2s ease;
    }
    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--orange); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(20px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .empty-state {
      text-align: center;
      padding: 36px 16px;
      color: var(--text-muted);
    }
    .empty-state i {
      font-size: 34px;
      margin-bottom: 10px;
      color: #B4C2D1;
    }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 14px;
    }

    /* ---------------- RESPONSIVE BREAKPOINTS ---------------- */
    @media (max-width: 1100px) {
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-dashboard-split { grid-template-columns: 1fr; }
    }

    @media (max-width: 900px) {
      .sidebar {
        transform: translateX(-100%);
      }
      body.mobile-drawer-open .sidebar {
        transform: translateX(0);
      }
      .main-wrapper,
      body.sidebar-collapsed .main-wrapper {
        margin-left: 0;
        width: 100%;
      }
      .grid-2 { grid-template-columns: 1fr; }
    }

    @media (max-width: 640px) {
      .top-header { padding: 0 14px; }
      .content-area { padding: 14px; }
      .subheader { padding: 14px; }
      .subheader-left h1 { font-size: 20px; }
      .grid-4, .grid-3, .form-row { grid-template-columns: 1fr; }
      .pill-orange { display: none; }
      .header-app-name span { display: none; }
    }
  </style>
</head>
<body>
  <!-- Toast Notification Stack -->
  <div id="toastStack" class="toast-stack" aria-live="polite"></div>

  <!-- AUTHENTICATION VIEW -->
  <section id="authView" class="auth-screen">
    <div class="auth-card">
      <div class="auth-brand">
        <div class="auth-brand-icon"><i class="fa-solid fa-graduation-cap"></i></div>
        <h1>EduPulse Portal</h1>
        <p>Academic Operations, Examinations &amp; Wallet Management</p>
      </div>

      <div class="auth-tabs" id="authTabs">
        <button type="button" class="auth-tab-btn active" data-auth-tab="login">
          <i class="fa-solid fa-right-to-bracket"></i> Sign In
        </button>
        <button type="button" class="auth-tab-btn" data-auth-tab="register">
          <i class="fa-solid fa-user-plus"></i> Register
        </button>
        <% if (needsAdminSetup) { %>
        <button type="button" class="auth-tab-btn" data-auth-tab="setup" id="setupTabBtn">
          <i class="fa-solid fa-shield-halved"></i> Admin Setup
        </button>
        <% } %>
      </div>

      <div class="auth-body">
        <% if (needsAdminSetup) { %>
        <div class="setup-banner" id="firstRunBanner">
          <i class="fa-solid fa-circle-info" style="margin-top:2px;"></i>
          <div>
            <strong>First-Run Setup:</strong> No administrator exists yet. Open the <strong>Admin Setup</strong> tab to create the initial administrator account, or register a Student account directly.
          </div>
        </div>
        <% } %>

        <!-- LOGIN FORM -->
        <form id="loginForm">
          <div class="form-group">
            <label class="form-label" for="loginIdentifier">Email or Username</label>
            <div class="input-wrap">
              <i class="fa-solid fa-envelope input-icon"></i>
              <input id="loginIdentifier" name="identifier" type="text" class="form-control" placeholder="name@edupulse.edu" required autocomplete="username" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="loginPassword">Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input id="loginPassword" name="password" type="password" class="form-control" placeholder="Enter your password" required autocomplete="current-password" />
              <button type="button" class="toggle-pw" data-toggle-pw="loginPassword" aria-label="Toggle password visibility">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>
          <div class="form-inline-between">
            <label class="checkbox-label">
              <input type="checkbox" id="loginRemember" name="rememberMe" />
              <span>Remember me (7 days)</span>
            </label>
            <a href="#" id="showForgotLink">Forgot password?</a>
          </div>
          <button type="submit" class="btn btn-primary btn-block" id="loginSubmitBtn">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In to Portal
          </button>
        </form>

        <!-- REGISTER FORM -->
        <form id="registerForm" class="hidden">
          <div class="form-group">
            <label class="form-label" for="regName">Full Name</label>
            <div class="input-wrap">
              <i class="fa-solid fa-user input-icon"></i>
              <input id="regName" name="name" type="text" class="form-control" placeholder="Alex Rivera" required minlength="2" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="regEmail">Email Address</label>
            <div class="input-wrap">
              <i class="fa-solid fa-envelope input-icon"></i>
              <input id="regEmail" name="email" type="email" class="form-control" placeholder="alex.rivera@student.edu" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="regDepartment">Department</label>
              <select id="regDepartment" name="department" class="form-control">
                <option value="Computer Science">Computer Science</option>
                <option value="Data Science">Data Science</option>
                <option value="Cybersecurity">Cybersecurity</option>
                <option value="Business Analytics">Business Analytics</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="regPhone">Phone Number</label>
              <input id="regPhone" name="phone" type="text" class="form-control" placeholder="+1 (555) 010-2000" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="regPassword">Password</label>
              <div class="input-wrap">
                <i class="fa-solid fa-lock input-icon"></i>
                <input id="regPassword" name="password" type="password" class="form-control" placeholder="Min 8 chars, A-z &amp; 0-9" required />
                <button type="button" class="toggle-pw" data-toggle-pw="regPassword" aria-label="Toggle password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="regConfirm">Confirm Password</label>
              <div class="input-wrap">
                <i class="fa-solid fa-lock input-icon"></i>
                <input id="regConfirm" name="confirmPassword" type="password" class="form-control" placeholder="Repeat password" required />
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-success btn-block" id="registerSubmitBtn">
            <i class="fa-solid fa-user-plus"></i> Create Student Account
          </button>
        </form>

        <!-- FORGOT PASSWORD FORM -->
        <form id="forgotForm" class="hidden">
          <p style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">
            Enter your registered email address to receive password reset instructions (or log a recovery request with portal administration).
          </p>
          <div class="form-group">
            <label class="form-label" for="forgotEmail">Account Email</label>
            <div class="input-wrap">
              <i class="fa-solid fa-envelope input-icon"></i>
              <input id="forgotEmail" type="email" class="form-control" placeholder="you@edupulse.edu" required />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block" id="forgotSubmitBtn">
            <i class="fa-solid fa-paper-plane"></i> Send Password Reset
          </button>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;gap:8px;flex-wrap:wrap;">
            <a href="#" id="backToLoginLink" style="font-size:13px;"><i class="fa-solid fa-arrow-left"></i> Back to Sign In</a>
            <a href="#" id="showResetTokenLink" style="font-size:13px;">Have a reset code?</a>
          </div>
        </form>

        <!-- RESET PASSWORD FORM -->
        <form id="resetPasswordForm" class="hidden">
          <p style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">
            Enter your reset token and choose a new password.
          </p>
          <div class="form-group">
            <label class="form-label" for="resetTokenInput">Reset Token</label>
            <div class="input-wrap">
              <i class="fa-solid fa-key input-icon"></i>
              <input id="resetTokenInput" type="text" class="form-control" placeholder="Paste reset token" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="resetNewPassword">New Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input id="resetNewPassword" type="password" class="form-control" placeholder="Min 8 chars, A-z &amp; 0-9" required />
              <button type="button" class="toggle-pw" data-toggle-pw="resetNewPassword" aria-label="Toggle password">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="resetConfirmPassword">Confirm New Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input id="resetConfirmPassword" type="password" class="form-control" placeholder="Repeat new password" required />
            </div>
          </div>
          <button type="submit" class="btn btn-success btn-block" id="resetPasswordBtn">
            <i class="fa-solid fa-check-double"></i> Reset Password
          </button>
          <div style="text-align:center;margin-top:14px;">
            <a href="#" id="backToLoginFromResetLink" style="font-size:13px;"><i class="fa-solid fa-arrow-left"></i> Back to Sign In</a>
          </div>
        </form>

        <!-- FIRST-RUN ADMIN SETUP FORM -->
        <% if (needsAdminSetup) { %>
        <form id="setupAdminForm" class="hidden">
          <div class="form-group">
            <label class="form-label" for="setupName">Administrator Name</label>
            <div class="input-wrap">
              <i class="fa-solid fa-user-shield input-icon"></i>
              <input id="setupName" type="text" class="form-control" value="System Administrator" required minlength="2" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="setupEmail">Administrator Email</label>
            <div class="input-wrap">
              <i class="fa-solid fa-envelope input-icon"></i>
              <input id="setupEmail" type="email" class="form-control" placeholder="admin@edupulse.edu" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="setupPassword">Administrator Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input id="setupPassword" type="password" class="form-control" placeholder="Min 8 chars, Uppercase, Lowercase, Number" required />
              <button type="button" class="toggle-pw" data-toggle-pw="setupPassword" aria-label="Toggle password">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-orange btn-block" id="setupAdminBtn">
            <i class="fa-solid fa-shield-halved"></i> Initialize Administrator Account
          </button>
        </form>
        <% } %>
      </div>
    </div>
  </section>

  <!-- PORTAL APPLICATION SHELL -->
  <div id="portalShell" class="portal-shell hidden">
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo"><i class="fa-solid fa-graduation-cap"></i></div>
        <div class="sidebar-title">
          EduPulse
          <span class="sidebar-subtitle" id="sidebarRoleLabel">Portal</span>
        </div>
      </div>

      <nav class="sidebar-nav" id="sidebarNav" aria-label="Primary Navigation"></nav>

      <div class="sidebar-footer">
        <i class="fa-solid fa-shield-check" style="color:var(--teal);margin-right:6px;"></i>
        <span>Encrypted Session Active</span>
      </div>
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="main-wrapper">
      <!-- TOP WHITE HEADER -->
      <header class="top-header">
        <div class="header-left">
          <button type="button" id="sidebarToggleBtn" class="hamburger-btn" aria-label="Toggle navigation menu">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div class="header-app-name">
            <i class="fa-solid fa-building-columns" style="color:var(--theme-light);"></i>
            <span>EduPulse Portal</span>
          </div>
        </div>

        <div class="header-right">
          <span class="status-pill pill-green" id="headerIdPill">
            <i class="fa-solid fa-id-badge"></i>
            <span id="headerUserIdText">ID</span>
          </span>
          <span class="status-pill pill-orange" id="headerWelcomePill">
            <i class="fa-solid fa-hand-sparkles"></i>
            <span id="headerWelcomeText">Welcome</span>
          </span>
          <button type="button" class="icon-btn" id="headerNotifBtn" title="Notifications" aria-label="Notifications">
            <i class="fa-solid fa-bell"></i>
            <span class="icon-dot hidden" id="headerNotifDot">0</span>
          </button>
          <button type="button" class="icon-btn" id="headerInboxBtn" title="Inbox" aria-label="Inbox">
            <i class="fa-solid fa-envelope"></i>
            <span class="icon-dot hidden" id="headerInboxDot">0</span>
          </button>
          <div class="header-avatar" id="headerProfileBtn" title="My Profile" role="button" tabindex="0"></div>
          <button type="button" class="status-pill pill-teal" id="headerLogoutBtn">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Logout</span>
          </button>
        </div>
      </header>

      <!-- DARK BLUE SUBHEADER & DYNAMIC BREADCRUMBS -->
      <section class="subheader">
        <div class="subheader-left">
          <div class="breadcrumbs" id="breadcrumbs">
            <span><i class="fa-solid fa-house"></i> Portal</span>
            <i class="fa-solid fa-chevron-right" style="font-size:10px;"></i>
            <span id="crumbModule">Dashboard</span>
            <i class="fa-solid fa-chevron-right" style="font-size:10px;"></i>
            <span id="crumbPage">Overview</span>
          </div>
          <h1 id="pageHeading">Dashboard</h1>
        </div>
        <div id="subheaderActionSlot"></div>
      </section>

      <!-- DYNAMIC SPA VIEWPORT -->
      <main class="content-area" id="appContent"></main>
    </div>
  </div>

  <!-- SHARED MODAL CONTAINER -->
  <div id="modalOverlay" class="modal-overlay hidden" role="dialog" aria-modal="true">
    <div class="modal-box" id="modalBox">
      <div class="modal-header">
        <h3 id="modalTitle">Dialog</h3>
        <button type="button" class="modal-close" id="modalCloseBtn" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>

  <script>
    'use strict';

    const App = {
      user: null,
      authToken: '',
      csrfToken: document.querySelector('meta[name="csrf-token"]').getAttribute('content') || '',
      currentView: 'dashboard',
      charts: {},
      examTimerInterval: null,
      activeExamState: null,
      studentPage: 1,
      departments: [],
      batches: [],

      async loadPublicDepartments() {
        try {
          const res = await this.api('/api/departments/public');
          if (res && Array.isArray(res.departments) && res.departments.length) {
            this.departments = res.departments;
            const regSelect = document.getElementById('regDepartment');
            if (regSelect) {
              regSelect.innerHTML = res.departments
                .map((d) => `<option value="${this.esc(d.name)}">${this.esc(d.name)} (${this.esc(d.code)})</option>`)
                .join('');
            }
          }
        } catch (_err) {
          // keep default options if unauthenticated fetch fails
        }
      },

      async ensureDepartments(force = false) {
        if (!force && this.departments && this.departments.length) return this.departments;
        try {
          const res = await this.api('/api/departments');
          this.departments = res.departments || [];
        } catch (_err) {
          this.departments = this.departments || [];
        }
        return this.departments;
      },

      async ensureBatches(force = false) {
        if (!force && this.batches && this.batches.length) return this.batches;
        try {
          const res = await this.api('/api/batches');
          this.batches = res.batches || [];
        } catch (_err) {
          this.batches = this.batches || [];
        }
        return this.batches;
      },

      esc(str) {
        if (str === null || str === undefined) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      },

      fmtDate(val) {
        if (!val) return '—';
        const d = new Date(val);
        if (Number.isNaN(d.getTime())) return '—';
        return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      },

      fmtDateTime(val) {
        if (!val) return '—';
        const d = new Date(val);
        if (Number.isNaN(d.getTime())) return '—';
        return d.toLocaleString(undefined, {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });
      },

      fmtMoney(num) {
        const val = Number(num) || 0;
        return '$' + val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      },

      showToast(message, type = 'info') {
        const stack = document.getElementById('toastStack');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        const iconMap = {
          success: 'fa-circle-check',
          error: 'fa-circle-exclamation',
          warning: 'fa-triangle-exclamation',
          info: 'fa-circle-info',
        };
        const colorMap = {
          success: 'var(--green)',
          error: 'var(--red)',
          warning: 'var(--orange)',
          info: 'var(--theme-light)',
        };
        toast.innerHTML = `<i class="fa-solid ${iconMap[type] || iconMap.info}" style="color:${colorMap[type] || colorMap.info};font-size:16px;"></i><span>${this.esc(message)}</span>`;
        stack.appendChild(toast);
        setTimeout(() => {
          toast.remove();
        }, 4200);
      },

      async api(url, options = {}) {
        const method = (options.method || 'GET').toUpperCase();
        const headers = Object.assign({ Accept: 'application/json' }, options.headers || {});
        if (this.authToken) {
          headers['Authorization'] = `Bearer ${this.authToken}`;
        }
        if (options.body && typeof options.body === 'object' && !(options.body instanceof FormData)) {
          headers['Content-Type'] = 'application/json';
        }
        if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {
          headers['X-CSRF-Token'] = this.csrfToken;
        }

        const response = await fetch(url, {
          method,
          headers,
          credentials: 'same-origin',
          body: options.body && typeof options.body === 'object' ? JSON.stringify(options.body) : options.body,
        });

        const contentType = response.headers.get('content-type') || '';
        const data = contentType.includes('application/json') ? await response.json() : null;

        if (response.status === 401 && !url.startsWith('/api/auth/login')) {
          this.user = null;
          this.authToken = '';
          this.showAuthScreen();
          throw new Error((data && data.message) || 'Session expired. Please sign in again.');
        }

        if (!response.ok || (data && data.success === false)) {
          throw new Error((data && data.message) || `Request failed (${response.status})`);
        }

        if (data && data.csrfToken) {
          this.csrfToken = data.csrfToken;
        }
        if (data && data.sessionToken) {
          this.authToken = data.sessionToken;
        }
        return data;
      },

      async downloadWithAuth(url, fallbackFilename = 'download') {
        try {
          const headers = {};
          if (this.authToken) {
            headers['Authorization'] = `Bearer ${this.authToken}`;
          }
          const res = await fetch(url, { headers, credentials: 'same-origin' });
          if (!res.ok) {
            throw new Error(`Download failed (${res.status})`);
          }
          const blob = await res.blob();
          const objectUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = objectUrl;
          a.download = fallbackFilename;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      showModal(title, bodyHtml, large = false) {
        const overlay = document.getElementById('modalOverlay');
        const box = document.getElementById('modalBox');
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalBody').innerHTML = bodyHtml;
        box.classList.toggle('modal-lg', Boolean(large));
        overlay.classList.remove('hidden');
      },

      closeModal() {
        document.getElementById('modalOverlay').classList.add('hidden');
        document.getElementById('modalBody').innerHTML = '';
      },

      destroyCharts() {
        Object.keys(this.charts).forEach((key) => {
          if (this.charts[key]) {
            this.charts[key].destroy();
            delete this.charts[key];
          }
        });
      },

      renderChart(canvasId, config) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || typeof Chart === 'undefined') return;
        if (this.charts[canvasId]) {
          this.charts[canvasId].destroy();
        }
        this.charts[canvasId] = new Chart(canvas.getContext('2d'), config);
      },

      readFileAsBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.onerror = () => reject(new Error('Failed to read file.'));
          reader.readAsDataURL(file);
        });
      },

      async uploadFile(file, category = 'answer_file', relatedExam = null) {
        if (!file) throw new Error('No file selected.');
        const maxBytes = category === 'profile_photo' ? 250 * 1024 : 5 * 1024 * 1024;
        if (file.size > maxBytes) {
          throw new Error(`File too large. Limit is ${category === 'profile_photo' ? '250 KB' : '5 MB'}.`);
        }
        const dataUrl = await this.readFileAsBase64(file);
        if (category === 'profile_photo') {
          return this.api('/api/profile/photo', {
            method: 'POST',
            body: { data: dataUrl, filename: file.name, mimeType: file.type },
          });
        }
        return this.api('/api/files/upload', {
          method: 'POST',
          body: { data: dataUrl, filename: file.name, mimeType: file.type, category, relatedExam },
        });
      },

      async init() {
        this.bindGlobalEvents();
        this.loadPublicDepartments();
        const urlParams = new URLSearchParams(window.location.search);
        const resetToken = urlParams.get('resetToken');
        if (resetToken) {
          document.getElementById('resetTokenInput').value = resetToken;
          if (window.history && window.history.replaceState) {
            window.history.replaceState({}, document.title, window.location.pathname);
          }
          this.showAuthScreen();
          this.switchAuthTab('reset');
          return;
        }
        try {
          const res = await this.api('/api/auth/me');
          this.user = res.user;
          this.enterPortal();
        } catch (_err) {
          this.showAuthScreen();
        }
      },

      bindGlobalEvents() {
        // Auth tab switching
        document.getElementById('authTabs').addEventListener('click', (e) => {
          const btn = e.target.closest('[data-auth-tab]');
          if (!btn) return;
          this.switchAuthTab(btn.getAttribute('data-auth-tab'));
        });

        // Password visibility toggles
        document.addEventListener('click', (e) => {
          const toggle = e.target.closest('[data-toggle-pw]');
          if (!toggle) return;
          const target = document.getElementById(toggle.getAttribute('data-toggle-pw'));
          if (!target) return;
          const isPw = target.type === 'password';
          target.type = isPw ? 'text' : 'password';
          toggle.innerHTML = isPw ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
        });

        document.getElementById('showForgotLink').addEventListener('click', (e) => {
          e.preventDefault();
          this.switchAuthTab('forgot');
        });
        document.getElementById('backToLoginLink').addEventListener('click', (e) => {
          e.preventDefault();
          this.switchAuthTab('login');
        });
        document.getElementById('showResetTokenLink').addEventListener('click', (e) => {
          e.preventDefault();
          this.switchAuthTab('reset');
        });
        document.getElementById('backToLoginFromResetLink').addEventListener('click', (e) => {
          e.preventDefault();
          this.switchAuthTab('login');
        });

        // Login submit
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('loginSubmitBtn');
          btn.disabled = true;
          try {
            const data = await this.api('/api/auth/login', {
              method: 'POST',
              body: {
                identifier: document.getElementById('loginIdentifier').value,
                password: document.getElementById('loginPassword').value,
                rememberMe: document.getElementById('loginRemember').checked,
              },
            });
            this.showToast(data.message, 'success');
            const me = await this.api('/api/auth/me');
            this.user = me.user;
            this.enterPortal();
          } catch (err) {
            this.showToast(err.message, 'error');
          } finally {
            btn.disabled = false;
          }
        });

        // Register submit
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('registerSubmitBtn');
          btn.disabled = true;
          try {
            const data = await this.api('/api/auth/register', {
              method: 'POST',
              body: {
                name: document.getElementById('regName').value,
                email: document.getElementById('regEmail').value,
                department: document.getElementById('regDepartment').value,
                phone: document.getElementById('regPhone').value,
                password: document.getElementById('regPassword').value,
                confirmPassword: document.getElementById('regConfirm').value,
              },
            });
            this.showToast(data.message, 'success');
            const me = await this.api('/api/auth/me');
            this.user = me.user;
            this.enterPortal();
          } catch (err) {
            this.showToast(err.message, 'error');
          } finally {
            btn.disabled = false;
          }
        });

        // Forgot password submit
        document.getElementById('forgotForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('forgotSubmitBtn');
          btn.disabled = true;
          try {
            const data = await this.api('/api/auth/forgot-password', {
              method: 'POST',
              body: { email: document.getElementById('forgotEmail').value },
            });
            this.showToast(data.message, data.emailSent ? 'success' : 'warning');
            if (data.emailSent) {
              this.switchAuthTab('reset');
            }
          } catch (err) {
            this.showToast(err.message, 'error');
          } finally {
            btn.disabled = false;
          }
        });

        // Reset password submit
        document.getElementById('resetPasswordForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('resetPasswordBtn');
          btn.disabled = true;
          try {
            const data = await this.api('/api/auth/reset-password', {
              method: 'POST',
              body: {
                token: document.getElementById('resetTokenInput').value,
                newPassword: document.getElementById('resetNewPassword').value,
                confirmPassword: document.getElementById('resetConfirmPassword').value,
              },
            });
            this.showToast(data.message, 'success');
            document.getElementById('resetPasswordForm').reset();
            this.switchAuthTab('login');
          } catch (err) {
            this.showToast(err.message, 'error');
          } finally {
            btn.disabled = false;
          }
        });

        // First-run Admin Setup submit
        const setupForm = document.getElementById('setupAdminForm');
        if (setupForm) {
          setupForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('setupAdminBtn');
            btn.disabled = true;
            try {
              const data = await this.api('/api/auth/setup-admin', {
                method: 'POST',
                body: {
                  name: document.getElementById('setupName').value,
                  email: document.getElementById('setupEmail').value,
                  password: document.getElementById('setupPassword').value,
                },
              });
              this.showToast(data.message, 'success');
              const me = await this.api('/api/auth/me');
              this.user = me.user;
              const setupTab = document.getElementById('setupTabBtn');
              const setupBanner = document.getElementById('firstRunBanner');
              if (setupTab) setupTab.remove();
              if (setupBanner) setupBanner.remove();
              this.enterPortal();
            } catch (err) {
              this.showToast(err.message, 'error');
            } finally {
              btn.disabled = false;
            }
          });
        }

        // Sidebar toggle (responsive desktop collapse vs mobile drawer)
        document.getElementById('sidebarToggleBtn').addEventListener('click', () => {
          if (window.innerWidth <= 900) {
            document.body.classList.toggle('mobile-drawer-open');
            document.getElementById('sidebarBackdrop').classList.toggle('open');
          } else {
            document.body.classList.toggle('sidebar-collapsed');
          }
        });

        document.getElementById('sidebarBackdrop').addEventListener('click', () => {
          document.body.classList.remove('mobile-drawer-open');
          document.getElementById('sidebarBackdrop').classList.remove('open');
        });

        // Header buttons
        document.getElementById('headerLogoutBtn').addEventListener('click', () => this.logout());
        document.getElementById('headerNotifBtn').addEventListener('click', () => this.navigate('notifications'));
        document.getElementById('headerInboxBtn').addEventListener('click', () => this.navigate('messages'));
        document.getElementById('headerProfileBtn').addEventListener('click', () => this.navigate('profile'));

        // Modal close
        document.getElementById('modalCloseBtn').addEventListener('click', () => this.closeModal());
        document.getElementById('modalOverlay').addEventListener('click', (e) => {
          if (e.target.id === 'modalOverlay') this.closeModal();
        });

        // Sidebar event delegation
        document.getElementById('sidebarNav').addEventListener('click', (e) => {
          const groupToggle = e.target.closest('[data-group-toggle]');
          if (groupToggle) {
            const list = groupToggle.nextElementSibling;
            if (list) list.classList.toggle('collapsed');
            return;
          }
          const navBtn = e.target.closest('[data-view]');
          if (navBtn) {
            this.navigate(navBtn.getAttribute('data-view'));
            if (window.innerWidth <= 900) {
              document.body.classList.remove('mobile-drawer-open');
              document.getElementById('sidebarBackdrop').classList.remove('open');
            }
          }
        });
      },

      switchAuthTab(tab) {
        document.querySelectorAll('.auth-tab-btn').forEach((b) => {
          b.classList.toggle('active', b.getAttribute('data-auth-tab') === tab);
        });
        ['loginForm', 'registerForm', 'forgotForm', 'resetPasswordForm', 'setupAdminForm'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.classList.add('hidden');
        });
        const map = {
          login: 'loginForm',
          register: 'registerForm',
          forgot: 'forgotForm',
          reset: 'resetPasswordForm',
          setup: 'setupAdminForm',
        };
        const target = document.getElementById(map[tab] || 'loginForm');
        if (target) target.classList.remove('hidden');
      },

      showAuthScreen() {
        if (this.examTimerInterval) clearInterval(this.examTimerInterval);
        this.destroyCharts();
        document.getElementById('portalShell').classList.add('hidden');
        document.getElementById('authView').classList.remove('hidden');
      },

      enterPortal() {
        document.getElementById('authView').classList.add('hidden');
        document.getElementById('portalShell').classList.remove('hidden');
        this.updateHeaderBadges();
        this.renderSidebar();
        this.navigate('dashboard');
      },

      updateHeaderBadges() {
        if (!this.user) return;
        document.getElementById('headerUserIdText').textContent = this.user.studentId || 'ADMIN';
        document.getElementById('headerWelcomeText').textContent = `Welcome, ${this.user.name.split(' ')[0]}`;
        document.getElementById('sidebarRoleLabel').textContent =
          this.user.role === 'admin' ? 'Admin Console' : 'Student Portal';

        const avatarEl = document.getElementById('headerProfileBtn');
        if (this.user.avatarBase64) {
          avatarEl.innerHTML = `<img src="${this.esc(this.user.avatarBase64)}" alt="Avatar" />`;
        } else {
          const initials = this.user.name
            .split(' ')
            .map((p) => p[0])
            .slice(0, 2)
            .join('')
            .toUpperCase();
          avatarEl.textContent = initials || 'U';
        }

        const notifDot = document.getElementById('headerNotifDot');
        const inboxDot = document.getElementById('headerInboxDot');
        if (this.user.unreadNotifications > 0) {
          notifDot.textContent = this.user.unreadNotifications;
          notifDot.classList.remove('hidden');
        } else {
          notifDot.classList.add('hidden');
        }
        if (this.user.unreadMessages > 0) {
          inboxDot.textContent = this.user.unreadMessages;
          inboxDot.classList.remove('hidden');
        } else {
          inboxDot.classList.add('hidden');
        }
      },

      async refreshUserCounts() {
        try {
          const res = await this.api('/api/auth/me');
          this.user = res.user;
          this.updateHeaderBadges();
          this.renderSidebar();
        } catch (_err) {
          // ignore silent background refresh failures
        }
      },

      renderSidebar() {
        const isAdmin = this.user && this.user.role === 'admin';
        const groups = isAdmin
          ? [
              {
                label: 'Overview',
                items: [
                  { view: 'dashboard', icon: 'fa-gauge-high', text: 'Admin Dashboard' },
