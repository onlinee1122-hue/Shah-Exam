        const isAdmin = this.user.role === 'admin';
        this.setPageMeta('Academics', isAdmin ? 'Submissions & Grading' : 'My Submissions');
        const data = await this.api('/api/submissions');

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    ${isAdmin ? '<th>Student</th>' : ''}
                    <th>Examination</th><th>Submitted</th><th>Status</th><th>Auto / Total Score</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.submissions.length ? data.submissions.map((sub) => `
                    <tr>
                      ${isAdmin ? `<td><strong>${this.esc(sub.student ? sub.student.name : '—')}</strong><br><small style="color:var(--text-muted);">${this.esc(sub.student ? sub.student.email : '')}</small></td>` : ''}
                      <td><strong>${this.esc(sub.examination ? sub.examination.code : '')}</strong> — ${this.esc(sub.examination ? sub.examination.title : '')}</td>
                      <td>${this.fmtDateTime(sub.submittedAt || sub.startedAt)}</td>
                      <td><span class="badge ${sub.status === 'evaluated' ? 'badge-green' : sub.status === 'submitted' ? 'badge-orange' : 'badge-blue'}">${this.esc(sub.status)}</span></td>
                      <td>${sub.totalScore} / ${sub.examination ? sub.examination.totalMarks : '-'}</td>
                      <td>
                        <button class="btn btn-primary btn-sm" onclick="App.openSubmissionDetail('${this.esc(sub._id)}')">
                          <i class="fa-solid ${isAdmin ? 'fa-marker' : 'fa-eye'}"></i> ${isAdmin ? 'Evaluate' : 'Review'}
                        </button>
                      </td>
                    </tr>`).join('') : `<tr><td colspan="${isAdmin ? 6 : 5}" class="empty-state">No submissions found.</td></tr>`}
                </tbody>
              </table>
            </div>
          </div>
        `;
      },

      async openSubmissionDetail(subId) {
        const isAdmin = this.user.role === 'admin';
        const data = await this.api(`/api/submissions/${subId}`);
        const { submission, questions, result } = data;
        const ansMap = new Map((submission.answers || []).map((a) => [String(a.question), a]));

        const bodyHtml = `
          <div style="margin-bottom:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div><strong>${this.esc(submission.examination.code)}</strong> — ${this.esc(submission.examination.title)}</div>
            <div>Student: <strong>${this.esc(submission.student.name)}</strong></div>
          </div>
          ${submission.answerFiles && submission.answerFiles.length ? `
            <div style="margin-bottom:14px;">
              <strong>Uploaded Answer Attachments:</strong>
              ${submission.answerFiles.map((f) => `<button type="button" onclick="App.downloadWithAuth('/api/files/${this.esc(f.fileId)}', '${this.esc(f.filename)}')" class="btn btn-outline btn-sm" style="margin-left:6px;"><i class="fa-solid fa-download"></i> ${this.esc(f.filename)}</button>`).join('')}
            </div>` : ''}
          <form id="evaluateForm">
            ${questions.map((q, idx) => {
              const a = ansMap.get(String(q._id)) || {};
              const studentResp = q.type === 'short_answer' ? (a.answerText || '—') : (a.selectedOption || '—');
              return `
                <div class="exam-question-card" data-eval-qid="${this.esc(q._id)}">
                  <div style="display:flex;justify-content:space-between;">
                    <strong>Q${idx + 1} (${this.esc(q.type)})</strong>
                    <span>Max: ${q.marks}</span>
                  </div>
                  <p style="margin:6px 0;">${this.esc(q.prompt)}</p>
                  <div style="background:#F3F7FB;padding:8px 10px;border-radius:6px;font-size:13px;">
                    <strong>Student Response:</strong> ${this.esc(studentResp)}
                  </div>
                  ${q.correctAnswer ? `<div style="font-size:12.5px;color:var(--green);margin-top:6px;"><strong>Answer Key:</strong> ${this.esc(q.correctAnswer)}</div>` : ''}
                  ${isAdmin ? `
                    <div class="form-row" style="margin-top:10px;">
                      <div class="form-group" style="margin-bottom:0;"><label class="form-label">Award Marks</label><input type="number" class="form-control eval-mark" min="0" max="${q.marks}" value="${a.awardedMarks || 0}" /></div>
                      <div class="form-group" style="margin-bottom:0;"><label class="form-label">Evaluator Note</label><input type="text" class="form-control eval-note" value="${this.esc(a.evaluatorNote || '')}" /></div>
                    </div>` : `<div style="margin-top:6px;font-size:12.5px;"><strong>Awarded:</strong> ${a.awardedMarks || 0} / ${q.marks}</div>`}
                </div>`;
            }).join('')}
            ${isAdmin ? `
              <div class="form-group"><label class="form-label">Overall Result Feedback</label><textarea id="evalFeedback" class="form-control">${this.esc(result ? result.feedback : '')}</textarea></div>
              <label class="checkbox-label" style="margin-bottom:14px;">
                <input type="checkbox" id="evalPublishNow" checked />
                <span>Publish Result &amp; Notify Student immediately</span>
              </label>
              <button type="submit" class="btn btn-success btn-block">Save Evaluation</button>
            ` : ''}
          </form>
        `;

        this.showModal(`Submission Review`, bodyHtml, true);
        if (isAdmin) {
          document.getElementById('evaluateForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const marks = [];
            document.querySelectorAll('[data-eval-qid]').forEach((el) => {
              marks.push({
                question: el.getAttribute('data-eval-qid'),
                awardedMarks: Number(el.querySelector('.eval-mark').value),
                evaluatorNote: el.querySelector('.eval-note').value,
              });
            });
            try {
              const out = await this.api(`/api/submissions/${subId}/evaluate`, {
                method: 'PUT',
                body: {
                  marks,
                  feedback: document.getElementById('evalFeedback').value,
                  publish: document.getElementById('evalPublishNow').checked,
                },
              });
              this.closeModal();
              this.showToast(out.message, 'success');
              this.loadSubmissions();
            } catch (err) {
              this.showToast(err.message, 'error');
            }
          });
        }
      },

