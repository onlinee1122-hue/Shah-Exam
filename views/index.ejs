                <div style="margin-top:14px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
                  <button class="btn btn-primary btn-sm" onclick="App.navigate('profile')"><i class="fa-solid fa-pen"></i> Edit Profile</button>
                  <label class="btn btn-outline btn-sm" style="cursor:pointer;">
                    <i class="fa-solid fa-camera"></i> Photo
                    <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" onchange="App.handleQuickAvatarUpload(this)" />
