      async handleQuickAvatarUpload(inputEl) {
        const file = inputEl.files && inputEl.files[0];
        if (!file) return;
        try {
          const res = await this.uploadFile(file, 'profile_photo');
          this.user.avatarBase64 = res.avatarBase64;
          this.updateHeaderBadges();
          this.showToast('Profile photo updated!', 'success');
          if (this.currentView === 'dashboard' || this.currentView === 'profile') {
            this.navigate(this.currentView);
          }
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      // ---------------- 2. STUDENTS MANAGEMENT (ADMIN) ----------------
      async loadStudents(search = '', status = '', department = '') {
        this.setPageMeta(
          'Students',
          'Student Directory & Management',
          `<button class="btn btn-orange btn-sm" onclick="App.openCreateStudentModal()"><i class="fa-solid fa-user-plus"></i> Register Student</button>`
        );
        const q = new URLSearchParams({ page: this.studentPage, limit: 10 });
        if (search) q.set('search', search);
        if (status) q.set('status', status);
        if (department) q.set('department', department);

        const [data, depts] = await Promise.all([
          this.api(`/api/students?${q.toString()}`),
          this.ensureDepartments(),
        ]);

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="toolbar">
              <div class="toolbar-filters">
                <input id="stuSearch" type="text" class="form-control" style="max-width:260px;" placeholder="Search name, email or ID..." value="${this.esc(search)}" />
                <select id="stuStatus" class="form-control" style="max-width:150px;">
                  <option value="">All Status</option>
                  <option value="active" ${status === 'active' ? 'selected' : ''}>Active</option>
                  <option value="inactive" ${status === 'inactive' ? 'selected' : ''}>Inactive</option>
                </select>
                <select id="stuDept" class="form-control" style="max-width:190px;">
                  <option value="">All Departments</option>
                  ${depts.map((d) => `<option value="${this.esc(d.name)}" ${department === d.name ? 'selected' : ''}>${this.esc(d.name)}</option>`).join('')}
                </select>
                <button class="btn btn-primary btn-sm" id="stuFilterBtn"><i class="fa-solid fa-magnifying-glass"></i> Filter</button>
              </div>
            </div>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Student ID</th><th>Name</th><th>Email</th><th>Department</th><th>Wallet</th><th>Status</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.students.length ? data.students.map((st) => `
                    <tr>
                      <td><strong>${this.esc(st.studentId)}</strong></td>
                      <td>${this.esc(st.name)}</td>
                      <td>${this.esc(st.email)}</td>
                      <td>${this.esc(st.department)}</td>
                      <td>${this.fmtMoney(st.walletBalance)}</td>
                      <td><span class="badge ${st.status === 'active' ? 'badge-green' : 'badge-red'}">${this.esc(st.status)}</span></td>
                      <td>
                        <div style="display:flex;gap:6px;">
                          <button class="btn btn-outline btn-sm" onclick="App.viewStudentDetail('${this.esc(st.id)}')" title="View Details"><i class="fa-solid fa-eye"></i></button>
                          <button class="btn btn-primary btn-sm" onclick="App.openEditStudentModal('${this.esc(st.id)}')" title="Edit"><i class="fa-solid fa-pen"></i></button>
                          <button class="btn btn-danger btn-sm" onclick="App.deleteStudent('${this.esc(st.id)}', '${this.esc(st.name)}')" title="Remove"><i class="fa-solid fa-trash"></i></button>
                        </div>
                      </td>
                    </tr>`).join('') : `<tr><td colspan="7" class="empty-state">No students match the selected filters.</td></tr>`}
                </tbody>
              </table>
            </div>

            <div class="pagination">
              <span style="font-size:12px;color:var(--text-muted);margin-right:auto;">Page ${data.pagination.page} of ${data.pagination.totalPages} (${data.pagination.total} students)</span>
              <button class="btn btn-outline btn-sm" ${data.pagination.page <= 1 ? 'disabled' : ''} id="stuPrevPage"><i class="fa-solid fa-chevron-left"></i> Prev</button>
              <button class="btn btn-outline btn-sm" ${data.pagination.page >= data.pagination.totalPages ? 'disabled' : ''} id="stuNextPage">Next <i class="fa-solid fa-chevron-right"></i></button>
            </div>
          </div>
        `;

        const runFilter = () => {
          this.studentPage = 1;
          this.loadStudents(
            document.getElementById('stuSearch').value,
            document.getElementById('stuStatus').value,
            document.getElementById('stuDept').value
          );
        };
        document.getElementById('stuFilterBtn').addEventListener('click', runFilter);
        document.getElementById('stuPrevPage').addEventListener('click', () => {
          this.studentPage = Math.max(1, this.studentPage - 1);
          this.loadStudents(search, status, department);
        });
        document.getElementById('stuNextPage').addEventListener('click', () => {
          this.studentPage += 1;
          this.loadStudents(search, status, department);
        });
      },

      async openCreateStudentModal() {
        const depts = await this.ensureDepartments();
        this.showModal('Register New Student', `
          <form id="createStudentForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Full Name</label><input id="csName" class="form-control" required /></div>
              <div class="form-group"><label class="form-label">Email</label><input id="csEmail" type="email" class="form-control" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Department</label>
                <select id="csDept" class="form-control">
                  ${depts.length ? depts.map((d) => `<option value="${this.esc(d.name)}">${this.esc(d.name)}</option>`).join('') : '<option value="Computer Science">Computer Science</option>'}
                </select>
              </div>
              <div class="form-group"><label class="form-label">Initial Wallet ($)</label><input id="csWallet" type="number" min="0" step="0.01" class="form-control" value="250" /></div>
            </div>
            <div class="form-group"><label class="form-label">Temporary Password (min 8 chars, A-z &amp; 0-9)</label><input id="csPassword" type="password" class="form-control" required /></div>
            <button type="submit" class="btn btn-primary btn-block">Create Student Account</button>
          </form>
        `);
        document.getElementById('createStudentForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/students', {
              method: 'POST',
              body: {
                name: document.getElementById('csName').value,
                email: document.getElementById('csEmail').value,
                department: document.getElementById('csDept').value,
                initialBalance: Number(document.getElementById('csWallet').value),
                password: document.getElementById('csPassword').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.navigate('students');
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async viewStudentDetail(id) {
        const res = await this.api(`/api/students/${id}`);
        const st = res.student;
        const p = st.profile || {};
        this.showModal(`Student Profile — ${st.name}`, `
          <div style="display:grid;gap:12px;">
            <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;">
              <div><strong>${this.esc(p.studentId)}</strong> &bull; ${this.esc(st.email)}</div>
              <span class="badge ${st.status === 'active' ? 'badge-green' : 'badge-red'}">${this.esc(st.status)}</span>
            </div>
            <div class="form-row">
              <div><small style="color:var(--text-muted);">Department</small><div>${this.esc(p.department)}</div></div>
              <div><small style="color:var(--text-muted);">Wallet Balance</small><div><strong>${this.fmtMoney(st.wallet ? st.wallet.balance : 0)}</strong></div></div>
            </div>
            <h4 style="margin-top:8px;">Examination History (${st.submissions.length})</h4>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Exam</th><th>Status</th><th>Score</th></tr></thead>
                <tbody>
                  ${st.submissions.length ? st.submissions.map((sub) => `
                    <tr>
                      <td>${this.esc(sub.examination ? sub.examination.title : 'Exam')}</td>
                      <td>${this.esc(sub.status)}</td>
                      <td>${sub.totalScore} / ${sub.examination ? sub.examination.totalMarks : '-'}</td>
                    </tr>`).join('') : `<tr><td colspan="3">No submissions yet.</td></tr>`}
                </tbody>
              </table>
            </div>
          </div>
        `, true);
      },

      async openEditStudentModal(id) {
        const res = await this.api(`/api/students/${id}`);
        const st = res.student;
        const p = st.profile || {};
        this.showModal(`Edit Student — ${st.name}`, `
          <form id="editStudentForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Full Name</label><input id="esName" class="form-control" value="${this.esc(st.name)}" required /></div>
              <div class="form-group">
                <label class="form-label">Account Status</label>
                <select id="esStatus" class="form-control">
                  <option value="active" ${st.status === 'active' ? 'selected' : ''}>Active</option>
                  <option value="inactive" ${st.status === 'inactive' ? 'selected' : ''}>Inactive</option>
                  <option value="suspended" ${st.status === 'suspended' ? 'selected' : ''}>Suspended</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Department</label><input id="esDept" class="form-control" value="${this.esc(p.department)}" /></div>
              <div class="form-group"><label class="form-label">Phone</label><input id="esPhone" class="form-control" value="${this.esc(p.phone)}" /></div>
            </div>
            <div class="form-group"><label class="form-label">Semester</label><input id="esSem" class="form-control" value="${this.esc(p.semester)}" /></div>
            <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
          </form>
          <hr style="border:none;border-top:1px solid var(--border-color);margin:18px 0;" />
          <form id="adminResetStuPwForm">
            <div class="form-group">
              <label class="form-label">Admin Password Reset (Optional)</label>
              <div style="display:flex;gap:8px;">
                <input id="esNewPassword" type="password" class="form-control" placeholder="New password (min 8 chars, A-z &amp; 0-9)" required />
                <button type="submit" class="btn btn-orange" style="white-space:nowrap;">Set Password</button>
              </div>
            </div>
          </form>
        `);
        document.getElementById('editStudentForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const out = await this.api(`/api/students/${id}`, {
              method: 'PUT',
              body: {
                name: document.getElementById('esName').value,
                status: document.getElementById('esStatus').value,
                department: document.getElementById('esDept').value,
                phone: document.getElementById('esPhone').value,
                semester: document.getElementById('esSem').value,
              },
            });
            this.closeModal();
            this.showToast(out.message, 'success');
            this.loadStudents();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
        document.getElementById('adminResetStuPwForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const out = await this.api(`/api/students/${id}/reset-password`, {
              method: 'POST',
              body: { newPassword: document.getElementById('esNewPassword').value },
            });
            this.showToast(out.message, 'success');
            document.getElementById('adminResetStuPwForm').reset();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async deleteStudent(id, name) {
        this.showModal('Confirm Student Removal', `
          <p style="margin-bottom:16px;">Are you sure you want to remove or deactivate <strong>${this.esc(name)}</strong>? Students with existing results or wallet transactions are safely deactivated.</p>
          <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button class="btn btn-outline" onclick="App.closeModal()">Cancel</button>
            <button class="btn btn-danger" id="confirmDelStuBtn">Confirm</button>
          </div>
        `);
        document.getElementById('confirmDelStuBtn').addEventListener('click', async () => {
          try {
            const res = await this.api(`/api/students/${id}`, { method: 'DELETE' });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.loadStudents();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      // ---------------- 3. EXAMINATIONS ----------------
      async loadExaminations() {
        const isAdmin = this.user.role === 'admin';
        this.setPageMeta(
          'Academics',
          'Examinations',
          isAdmin ? `<button class="btn btn-orange btn-sm" onclick="App.openCreateExamModal()"><i class="fa-solid fa-plus"></i> Create Examination</button>` : ''
        );

        const data = await this.api('/api/examinations');
        const exams = data.examinations;

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Code</th><th>Title &amp; Course</th><th>Date</th><th>Duration</th><th>Marks</th><th>Questions</th><th>Status</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  ${exams.length ? exams.map((ex) => {
                    const statusBadge =
                      ex.status === 'published' ? 'badge-green' : ex.status === 'draft' ? 'badge-orange' : 'badge-muted';
                    let studentAction = '';
                    if (!isAdmin) {
                      if (ex.myResult) {
                        studentAction = `<span class="badge badge-teal">Scored ${ex.myResult.percentage}% (${this.esc(ex.myResult.grade)})</span>`;
                      } else if (ex.mySubmission && ex.mySubmission.status !== 'in_progress') {
                        studentAction = `<span class="badge badge-blue">Submitted</span>`;
                      } else {
                        studentAction = `<button class="btn btn-primary btn-sm" onclick="App.navigate('take-exam', { examId: '${this.esc(ex._id)}' })"><i class="fa-solid fa-play"></i> ${ex.mySubmission ? 'Resume' : 'Start Exam'}</button>`;
                      }
                    }
                    return `
                    <tr>
                      <td><strong>${this.esc(ex.code)}</strong></td>
                      <td>
                        <div style="font-weight:600;">${this.esc(ex.title)}</div>
                        <small style="color:var(--text-muted);">${this.esc(ex.course)}</small>
                      </td>
                      <td>${this.fmtDate(ex.examDate)}</td>
                      <td>${ex.durationMinutes} min</td>
                      <td>${ex.totalMarks} (Pass: ${ex.passingMarks})</td>
                      <td>${ex.questionCount} items</td>
                      <td><span class="badge ${statusBadge}">${this.esc(ex.status)}</span></td>
                      <td>
                        ${isAdmin ? `
                          <div style="display:flex;gap:6px;flex-wrap:wrap;">
                            <button class="btn btn-teal btn-sm" onclick="App.navigate('questions', { examId: '${this.esc(ex._id)}' })" title="Manage Questions"><i class="fa-solid fa-list-ol"></i> Questions</button>
                            <button class="btn btn-primary btn-sm" onclick="App.toggleExamPublish('${this.esc(ex._id)}', '${this.esc(ex.status)}')">${ex.status === 'published' ? 'Unpublish' : 'Publish'}</button>
                            <button class="btn btn-danger btn-sm" onclick="App.deleteExam('${this.esc(ex._id)}')"><i class="fa-solid fa-trash"></i></button>
                          </div>
                        ` : studentAction}
                      </td>
                    </tr>`;
                  }).join('') : `<tr><td colspan="8" class="empty-state">No examinations available.</td></tr>`}
                </tbody>
              </table>
            </div>
          </div>
        `;
      },

      // ---------------- 2B. DEPARTMENTS & COURSES (ADMIN) ----------------
      async loadDepartments() {
        this.setPageMeta(
          'Academics',
          'Departments & Courses',
          `<button class="btn btn-orange btn-sm" onclick="App.openCreateDepartmentModal()"><i class="fa-solid fa-plus"></i> Create New Department</button>`
        );
        const depts = await this.ensureDepartments(true);

        document.getElementById('appContent').innerHTML = `
          <div style="display:grid;gap:18px;">
            ${depts.length ? depts.map((dept) => `
              <div class="card">
                <div class="card-header" style="flex-wrap:wrap;gap:10px;">
                  <div>
                    <div class="card-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                      <i class="fa-solid fa-building-columns" style="color:var(--theme-light);"></i>
                      <span>${this.esc(dept.name)}</span>
                      <span class="badge badge-blue">${this.esc(dept.code)}</span>
                      <span class="badge ${dept.status === 'active' ? 'badge-green' : 'badge-muted'}">${this.esc(dept.status)}</span>
                    </div>
                    ${dept.description ? `<p style="font-size:12.5px;color:var(--text-muted);margin-top:4px;">${this.esc(dept.description)}</p>` : ''}
                  </div>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button type="button" class="btn btn-primary btn-sm" data-edit-dept="${this.esc(dept._id)}"><i class="fa-solid fa-pen"></i> Edit</button>
                    <button type="button" class="btn btn-teal btn-sm" data-add-course-dept="${this.esc(dept._id)}"><i class="fa-solid fa-plus"></i> Add Course</button>
                    <button type="button" class="btn btn-danger btn-sm" data-del-dept="${this.esc(dept._id)}"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Course Code</th><th>Course Title</th><th>Credits</th><th>Study Options</th><th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${(dept.courses && dept.courses.length) ? dept.courses.map((c) => `
                        <tr>
                          <td><strong>${this.esc(c.code)}</strong></td>
                          <td>${this.esc(c.title)}</td>
                          <td>${c.credits || 3}</td>
                          <td>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                              ${(c.studyOptions || []).map((opt) => `<span class="badge badge-teal">${this.esc(opt)}</span>`).join('')}
                            </div>
                          </td>
                          <td>
                            <div style="display:flex;gap:6px;">
                              <button type="button" class="btn btn-primary btn-sm" data-edit-course="${this.esc(c._id)}" data-dept-id="${this.esc(dept._id)}" title="Edit Course"><i class="fa-solid fa-pen"></i></button>
                              <button type="button" class="btn btn-danger btn-sm" data-del-course="${this.esc(c._id)}" data-dept-id="${this.esc(dept._id)}" title="Remove Course"><i class="fa-solid fa-trash"></i></button>
                            </div>
                          </td>
                        </tr>`).join('') : `<tr><td colspan="5" class="empty-state">No courses added to this department yet.</td></tr>`}
                    </tbody>
                  </table>
                </div>
              </div>`).join('') : `
              <div class="card"><div class="empty-state"><i class="fa-solid fa-sitemap"></i><h3>No departments configured</h3><p>Click "Create New Department" to add your first academic department and its courses.</p></div></div>`}
          </div>
        `;

        const container = document.getElementById('appContent');
        container.querySelectorAll('[data-edit-dept]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const dept = depts.find((d) => String(d._id) === btn.getAttribute('data-edit-dept'));
            if (dept) this.openEditDepartmentModal(dept);
          });
        });
        container.querySelectorAll('[data-add-course-dept]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const dept = depts.find((d) => String(d._id) === btn.getAttribute('data-add-course-dept'));
            if (dept) this.openAddCourseModal(dept._id, dept.name);
          });
        });
        container.querySelectorAll('[data-del-dept]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const dept = depts.find((d) => String(d._id) === btn.getAttribute('data-del-dept'));
            if (dept) this.deleteDepartment(dept._id, dept.name);
          });
        });
        container.querySelectorAll('[data-edit-course]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const deptId = btn.getAttribute('data-dept-id');
            const courseId = btn.getAttribute('data-edit-course');
            const dept = depts.find((d) => String(d._id) === deptId);
            const course = dept && (dept.courses || []).find((c) => String(c._id) === courseId);
            if (dept && course) this.openEditCourseModal(dept, course);
          });
        });
        container.querySelectorAll('[data-del-course]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const deptId = btn.getAttribute('data-dept-id');
            const courseId = btn.getAttribute('data-del-course');
            const dept = depts.find((d) => String(d._id) === deptId);
            const course = dept && (dept.courses || []).find((c) => String(c._id) === courseId);
            this.deleteCourse(deptId, courseId, course ? course.title : 'Course');
          });
        });
      },

      openEditDepartmentModal(dept) {
        this.showModal(`Edit Department — ${dept.name}`, `
          <form id="editDeptForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Department Name</label><input id="edName" class="form-control" value="${this.esc(dept.name)}" required /></div>
              <div class="form-group"><label class="form-label">Department Code</label><input id="edCode" class="form-control" value="${this.esc(dept.code)}" required /></div>
            </div>
            <div class="form-group">
              <label class="form-label">Status</label>
              <select id="edStatus" class="form-control">
                <option value="active" ${dept.status === 'active' ? 'selected' : ''}>Active</option>
                <option value="inactive" ${dept.status === 'inactive' ? 'selected' : ''}>Inactive</option>
              </select>
            </div>
            <div class="form-group"><label class="form-label">Description</label><textarea id="edDesc" class="form-control">${this.esc(dept.description || '')}</textarea></div>
            <button type="submit" class="btn btn-primary btn-block">Update Department</button>
          </form>
        `);

        document.getElementById('editDeptForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api(`/api/departments/${dept._id}`, {
              method: 'PUT',
              body: {
                name: document.getElementById('edName').value,
                code: document.getElementById('edCode').value,
                status: document.getElementById('edStatus').value,
                description: document.getElementById('edDesc').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureDepartments(true);
            this.loadDepartments();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      openEditCourseModal(dept, course) {
        const studyOptionChoices = ['Full-Time', 'Part-Time', 'Online', 'Hybrid', 'Evening', 'Weekend'];
        const existingOpts = Array.isArray(course.studyOptions) ? course.studyOptions : [];
        const customExisting = existingOpts.filter((o) => !studyOptionChoices.includes(o));

        this.showModal(`Edit Course — ${dept.name}`, `
          <form id="editCourseForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Course Code</label><input id="ecCode" class="form-control" value="${this.esc(course.code)}" required /></div>
              <div class="form-group"><label class="form-label">Course Title</label><input id="ecTitle" class="form-control" value="${this.esc(course.title)}" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Credits</label><input id="ecCredits" type="number" min="1" max="20" class="form-control" value="${Number(course.credits) || 3}" /></div>
              <div class="form-group"><label class="form-label">Custom Study Options (comma separated)</label><input id="ecCustomOpts" class="form-control" value="${this.esc(customExisting.join(', '))}" placeholder="e.g. Bootcamp, Self-Paced" /></div>
            </div>
            <div class="form-group">
              <label class="form-label">Study Options (select all offered)</label>
              <div style="display:flex;gap:12px;flex-wrap:wrap;">
                ${studyOptionChoices.map((opt) => `
                  <label class="checkbox-label" style="font-size:12.5px;">
                    <input type="checkbox" class="ec-opt-cb" value="${this.esc(opt)}" ${existingOpts.includes(opt) ? 'checked' : ''} />
                    <span>${this.esc(opt)}</span>
                  </label>`).join('')}
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Save Course Changes</button>
          </form>
        `);

        document.getElementById('editCourseForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const checked = Array.from(document.querySelectorAll('.ec-opt-cb:checked')).map((cb) => cb.value);
            const customList = (document.getElementById('ecCustomOpts').value || '').split(',').map((s) => s.trim()).filter(Boolean);
            const res = await this.api(`/api/departments/${dept._id}/courses/${course._id}`, {
              method: 'PUT',
              body: {
                code: document.getElementById('ecCode').value,
                title: document.getElementById('ecTitle').value,
                credits: Number(document.getElementById('ecCredits').value) || 3,
                studyOptions: Array.from(new Set([...checked, ...customList])),
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureDepartments(true);
            this.loadDepartments();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      openCreateDepartmentModal() {
        const studyOptionChoices = ['Full-Time', 'Part-Time', 'Online', 'Hybrid', 'Evening', 'Weekend'];
        let courseRowCounter = 1;

        const buildCourseRow = (idx) => `
          <div class="dept-course-row" data-course-row="${idx}" style="border:1px solid var(--border-color);border-radius:8px;padding:12px;margin-bottom:10px;background:#F9FBFD;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
              <strong style="font-size:12.5px;color:var(--theme-dark);">Course #${idx}</strong>
              ${idx > 1 ? `<button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.dept-course-row').remove()"><i class="fa-solid fa-xmark"></i></button>` : ''}
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Course Code</label><input class="form-control dc-code" placeholder="e.g. AI-101" required /></div>
              <div class="form-group"><label class="form-label">Course Title</label><input class="form-control dc-title" placeholder="e.g. Applied Machine Learning" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Credits</label><input type="number" min="1" max="20" class="form-control dc-credits" value="3" /></div>
              <div class="form-group"><label class="form-label">Extra Custom Study Option (optional)</label><input class="form-control dc-custom-opt" placeholder="e.g. Self-Paced, Lab Intensive" /></div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Study Options (select multiple)</label>
              <div style="display:flex;gap:12px;flex-wrap:wrap;">
                ${studyOptionChoices.map((opt) => `
                  <label class="checkbox-label" style="font-size:12.5px;">
                    <input type="checkbox" class="dc-opt-cb" value="${this.esc(opt)}" ${opt === 'Full-Time' ? 'checked' : ''} />
                    <span>${this.esc(opt)}</span>
                  </label>`).join('')}
              </div>
            </div>
          </div>
        `;

        this.showModal('Create New Department & Courses', `
          <form id="createDeptForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Department Name</label><input id="deptName" class="form-control" placeholder="e.g. Artificial Intelligence" required /></div>
              <div class="form-group"><label class="form-label">Department Code</label><input id="deptCode" class="form-control" placeholder="e.g. AI" required /></div>
            </div>
            <div class="form-group"><label class="form-label">Description</label><textarea id="deptDesc" class="form-control" placeholder="Department overview..."></textarea></div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin:12px 0 8px;">
              <label class="form-label" style="margin:0;">Department Courses &amp; Study Options</label>
              <button type="button" class="btn btn-teal btn-sm" id="addMoreCourseRowBtn"><i class="fa-solid fa-plus"></i> Add Another Course</button>
            </div>
            <div id="deptCoursesContainer">${buildCourseRow(1)}</div>
            <button type="submit" class="btn btn-primary btn-block" style="margin-top:8px;">Create Department</button>
          </form>
        `, true);

        document.getElementById('addMoreCourseRowBtn').addEventListener('click', () => {
          courseRowCounter += 1;
          document.getElementById('deptCoursesContainer').insertAdjacentHTML('beforeend', buildCourseRow(courseRowCounter));
        });

        document.getElementById('createDeptForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const rows = Array.from(document.querySelectorAll('#deptCoursesContainer .dept-course-row'));
            const courses = rows.map((row) => {
              const checked = Array.from(row.querySelectorAll('.dc-opt-cb:checked')).map((cb) => cb.value);
              const customRaw = row.querySelector('.dc-custom-opt').value || '';
              const customList = customRaw.split(',').map((s) => s.trim()).filter(Boolean);
              return {
                code: row.querySelector('.dc-code').value,
                title: row.querySelector('.dc-title').value,
                credits: Number(row.querySelector('.dc-credits').value) || 3,
                studyOptions: Array.from(new Set([...checked, ...customList])),
              };
            });

            const res = await this.api('/api/departments', {
              method: 'POST',
              body: {
                name: document.getElementById('deptName').value,
                code: document.getElementById('deptCode').value,
                description: document.getElementById('deptDesc').value,
                courses,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureDepartments(true);
            this.loadDepartments();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      openAddCourseModal(deptId, deptName) {
        const studyOptionChoices = ['Full-Time', 'Part-Time', 'Online', 'Hybrid', 'Evening', 'Weekend'];
        this.showModal(`Add Course to ${deptName}`, `
          <form id="addCourseForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Course Code</label><input id="acCode" class="form-control" placeholder="e.g. CS-450" required /></div>
              <div class="form-group"><label class="form-label">Course Title</label><input id="acTitle" class="form-control" placeholder="e.g. Distributed Databases" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Credits</label><input id="acCredits" type="number" min="1" max="20" class="form-control" value="3" /></div>
              <div class="form-group"><label class="form-label">Custom Study Options (comma separated)</label><input id="acCustomOpts" class="form-control" placeholder="e.g. Bootcamp, Self-Paced" /></div>
            </div>
            <div class="form-group">
              <label class="form-label">Study Options (select all offered)</label>
              <div style="display:flex;gap:12px;flex-wrap:wrap;">
                ${studyOptionChoices.map((opt) => `
                  <label class="checkbox-label" style="font-size:12.5px;">
                    <input type="checkbox" class="ac-opt-cb" value="${this.esc(opt)}" ${opt === 'Full-Time' ? 'checked' : ''} />
                    <span>${this.esc(opt)}</span>
                  </label>`).join('')}
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Save Course</button>
          </form>
        `);

        document.getElementById('addCourseForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const checked = Array.from(document.querySelectorAll('.ac-opt-cb:checked')).map((cb) => cb.value);
            const customList = (document.getElementById('acCustomOpts').value || '').split(',').map((s) => s.trim()).filter(Boolean);
            const res = await this.api(`/api/departments/${deptId}/courses`, {
              method: 'POST',
              body: {
                code: document.getElementById('acCode').value,
                title: document.getElementById('acTitle').value,
                credits: Number(document.getElementById('acCredits').value) || 3,
                studyOptions: Array.from(new Set([...checked, ...customList])),
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureDepartments(true);
            this.loadDepartments();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async deleteCourse(deptId, courseId, title) {
        try {
          const res = await this.api(`/api/departments/${deptId}/courses/${courseId}`, { method: 'DELETE' });
          this.showToast(`Removed course ${title}.`, 'success');
          await this.ensureDepartments(true);
          this.loadDepartments();
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      async deleteDepartment(deptId, name) {
        this.showModal('Confirm Department Removal', `
          <p style="margin-bottom:16px;">Remove department <strong>${this.esc(name)}</strong> and its course list?</p>
          <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button class="btn btn-outline" onclick="App.closeModal()">Cancel</button>
            <button class="btn btn-danger" id="confirmDelDeptBtn">Remove</button>
          </div>
        `);
        document.getElementById('confirmDelDeptBtn').addEventListener('click', async () => {
          try {
            const res = await this.api(`/api/departments/${deptId}`, { method: 'DELETE' });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureDepartments(true);
            this.loadDepartments();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      // ---------------- 2C. BATCHES MANAGEMENT (ADMIN) ----------------
      async loadBatches() {
        this.setPageMeta(
          'Academics',
          'Batch Numbers',
          `<button class="btn btn-orange btn-sm" onclick="App.openCreateBatchModal()"><i class="fa-solid fa-plus"></i> Add New Batch</button>`
        );
        const batches = await this.ensureBatches(true);

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Batch Number</th><th>Department</th><th>Course</th><th>Study Option</th><th>Description</th><th>Status</th><th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  ${batches.length ? batches.map((b) => `
                    <tr>
                      <td><strong>${this.esc(b.batchNumber)}</strong></td>
                      <td>${this.esc(b.department || 'All Departments')}</td>
                      <td>${this.esc(b.course || 'All Courses')}</td>
                      <td>${b.studyOption ? `<span class="badge badge-teal">${this.esc(b.studyOption)}</span>` : '—'}</td>
                      <td>${this.esc(b.description || '—')}</td>
                      <td><span class="badge ${b.status === 'active' ? 'badge-green' : 'badge-muted'}">${this.esc(b.status)}</span></td>
                      <td>
                        <div style="display:flex;gap:6px;">
                          <button type="button" class="btn btn-primary btn-sm" data-edit-batch="${this.esc(b._id)}" title="Edit Batch"><i class="fa-solid fa-pen"></i></button>
                          <button type="button" class="btn btn-danger btn-sm" data-del-batch="${this.esc(b._id)}" title="Remove Batch"><i class="fa-solid fa-trash"></i></button>
                        </div>
                      </td>
                    </tr>`).join('') : `<tr><td colspan="7" class="empty-state">No batch numbers configured yet. Click "Add New Batch" to create one.</td></tr>`}
                </tbody>
              </table>
            </div>
          </div>
        `;

        const container = document.getElementById('appContent');
        container.querySelectorAll('[data-edit-batch]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const batch = batches.find((b) => String(b._id) === btn.getAttribute('data-edit-batch'));
            if (batch) this.openEditBatchModal(batch);
          });
        });
        container.querySelectorAll('[data-del-batch]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const batch = batches.find((b) => String(b._id) === btn.getAttribute('data-del-batch'));
            if (batch) this.deleteBatch(batch);
          });
        });
      },

      async openCreateBatchModal(onSaved = null) {
        const depts = await this.ensureDepartments(true);
        this.showModal('Add New Batch Number', `
          <form id="createBatchForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Batch Number</label><input id="cbNumber" class="form-control" placeholder="e.g. BATCH-04 or B-2026-A" required /></div>
              <div class="form-group">
                <label class="form-label">Department (Optional)</label>
                <select id="cbDept" class="form-control">
                  <option value="">All Departments</option>
                  ${depts.map((d) => `<option value="${this.esc(d.name)}">${this.esc(d.name)} (${this.esc(d.code)})</option>`).join('')}
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Course (Optional)</label>
                <select id="cbCourse" class="form-control">
                  <option value="">All Courses</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Study Option (Optional)</label>
                <select id="cbStudy" class="form-control">
                  <option value="">Any Study Option</option>
                  <option value="Full-Time">Full-Time</option>
                  <option value="Part-Time">Part-Time</option>
                  <option value="Online">Online</option>
                  <option value="Hybrid">Hybrid</option>
                  <option value="Evening">Evening</option>
                  <option value="Weekend">Weekend</option>
                </select>
              </div>
            </div>
            <div class="form-group"><label class="form-label">Description / Notes</label><input id="cbDesc" class="form-control" placeholder="e.g. Spring 2027 Morning Cohort" /></div>
            <button type="submit" class="btn btn-primary btn-block">Save Batch Number</button>
          </form>
        `);

        const deptEl = document.getElementById('cbDept');
        const courseEl = document.getElementById('cbCourse');
        const syncCourses = () => {
          const dept = depts.find((d) => d.name === deptEl.value);
          const list = dept ? (dept.courses || []) : depts.flatMap((d) => d.courses || []);
          courseEl.innerHTML = `<option value="">All Courses</option>` +
            list.map((c) => `<option value="${this.esc(c.title)}">${this.esc(c.code)} — ${this.esc(c.title)}</option>`).join('');
        };
        syncCourses();
        deptEl.addEventListener('change', syncCourses);

        document.getElementById('createBatchForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/batches', {
              method: 'POST',
              body: {
                batchNumber: document.getElementById('cbNumber').value,
                department: deptEl.value,
                course: courseEl.value,
                studyOption: document.getElementById('cbStudy').value,
                description: document.getElementById('cbDesc').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureBatches(true);
            if (typeof onSaved === 'function') onSaved(res.batch);
            else if (this.currentView === 'batches') this.loadBatches();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async openEditBatchModal(batch) {
        const depts = await this.ensureDepartments(true);
        this.showModal(`Edit Batch — ${batch.batchNumber}`, `
          <form id="editBatchForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Batch Number</label><input id="ebNumber" class="form-control" value="${this.esc(batch.batchNumber)}" required /></div>
              <div class="form-group">
                <label class="form-label">Status</label>
                <select id="ebStatus" class="form-control">
                  <option value="active" ${batch.status === 'active' ? 'selected' : ''}>Active</option>
                  <option value="inactive" ${batch.status === 'inactive' ? 'selected' : ''}>Inactive</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Department</label>
                <select id="ebDept" class="form-control">
                  <option value="">All Departments</option>
                  ${depts.map((d) => `<option value="${this.esc(d.name)}" ${batch.department === d.name ? 'selected' : ''}>${this.esc(d.name)} (${this.esc(d.code)})</option>`).join('')}
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Course</label>
                <select id="ebCourse" class="form-control"></select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Study Option</label>
                <select id="ebStudy" class="form-control">
                  <option value="">Any Study Option</option>
                  ${['Full-Time', 'Part-Time', 'Online', 'Hybrid', 'Evening', 'Weekend'].map((o) => `<option value="${this.esc(o)}" ${batch.studyOption === o ? 'selected' : ''}>${this.esc(o)}</option>`).join('')}
                </select>
              </div>
              <div class="form-group"><label class="form-label">Description</label><input id="ebDesc" class="form-control" value="${this.esc(batch.description || '')}" /></div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Update Batch</button>
          </form>
        `);

        const deptEl = document.getElementById('ebDept');
        const courseEl = document.getElementById('ebCourse');
        const syncCourses = (prefer = '') => {
          const dept = depts.find((d) => d.name === deptEl.value);
          const list = dept ? (dept.courses || []) : depts.flatMap((d) => d.courses || []);
          courseEl.innerHTML = `<option value="">All Courses</option>` +
            list.map((c) => `<option value="${this.esc(c.title)}">${this.esc(c.code)} — ${this.esc(c.title)}</option>`).join('');
          if (prefer) courseEl.value = prefer;
        };
        syncCourses(batch.course || '');
        deptEl.addEventListener('change', () => syncCourses(''));

        document.getElementById('editBatchForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api(`/api/batches/${batch._id}`, {
              method: 'PUT',
              body: {
                batchNumber: document.getElementById('ebNumber').value,
                status: document.getElementById('ebStatus').value,
                department: deptEl.value,
                course: courseEl.value,
                studyOption: document.getElementById('ebStudy').value,
                description: document.getElementById('ebDesc').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureBatches(true);
            this.loadBatches();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async deleteBatch(batch) {
        this.showModal('Confirm Batch Removal', `
          <p style="margin-bottom:16px;">Remove batch <strong>${this.esc(batch.batchNumber)}</strong> from the batch list?</p>
          <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button class="btn btn-outline" onclick="App.closeModal()">Cancel</button>
            <button class="btn btn-danger" id="confirmDelBatchBtn">Remove</button>
          </div>
        `);
        document.getElementById('confirmDelBatchBtn').addEventListener('click', async () => {
          try {
            const res = await this.api(`/api/batches/${batch._id}`, { method: 'DELETE' });
            this.closeModal();
            this.showToast(res.message, 'success');
            await this.ensureBatches(true);
            this.loadBatches();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async openCreateExamModal() {
        const [depts, batches] = await Promise.all([
          this.ensureDepartments(true),
          this.ensureBatches(true),
        ]);
        const defaultDate = new Date(Date.now() + 3 * 86400000).toISOString().slice(0, 10);
        this.showModal('Create Examination', `
          <form id="createExamForm">
            <div class="form-row">
              <div class="form-group"><label class="form-label">Exam Title</label><input id="exTitle" class="form-control" required /></div>
              <div class="form-group"><label class="form-label">Exam Code</label><input id="exCode" class="form-control" placeholder="CS-402-FIN" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Department</label>
                <select id="exDept" class="form-control">
                  <option value="">-- Select Department --</option>
                  ${depts.map((d) => `<option value="${this.esc(d.name)}">${this.esc(d.name)} (${this.esc(d.code)})</option>`).join('')}
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Course</label>
                <select id="exCourseSelect" class="form-control"></select>
                <input id="exCourse" class="form-control hidden" style="margin-top:6px;" placeholder="Enter custom course name" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Study Option</label>
                <select id="exStudyOption" class="form-control">
                  <option value="Full-Time">Full-Time</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Batch Number (Optional)</label>
                <select id="exBatchSelect" class="form-control">
                  <option value="">-- Optional / None --</option>
                  ${batches.filter((b) => b.status === 'active').map((b) => `<option value="${this.esc(b.batchNumber)}">${this.esc(b.batchNumber)}</option>`).join('')}
                  <option value="__new_batch__">+ Add New Batch Number...</option>
                </select>
                <input id="exBatch" class="form-control hidden" style="margin-top:6px;" placeholder="Enter new batch e.g. BATCH-04" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Exam Date</label><input id="exDate" type="date" class="form-control" value="${defaultDate}" required /></div>
              <div class="form-group"><label class="form-label">Duration (minutes)</label><input id="exDur" type="number" min="5" max="360" class="form-control" value="45" required /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label class="form-label">Status</label><select id="exStatus" class="form-control"><option value="published">Published</option><option value="draft">Draft</option></select></div>
              <div class="form-group"><label class="form-label">Total / Passing Marks</label>
                <div style="display:flex;gap:8px;">
                  <input id="exTotal" type="number" min="1" class="form-control" value="100" required title="Total Marks" />
                  <input id="exPass" type="number" min="0" class="form-control" value="50" required title="Passing Marks" />
                </div>
              </div>
            </div>
            <div class="form-group"><label class="form-label">Description &amp; Instructions</label><textarea id="exDesc" class="form-control" placeholder="Examination scope and rules..."></textarea></div>
            <button type="submit" class="btn btn-primary btn-block">Create Examination</button>
          </form>
        `);

        const deptEl = document.getElementById('exDept');
        const courseSelEl = document.getElementById('exCourseSelect');
        const courseInputEl = document.getElementById('exCourse');
        const studySelEl = document.getElementById('exStudyOption');
        const exBatchSelEl = document.getElementById('exBatchSelect');
        const exBatchInputEl = document.getElementById('exBatch');

        exBatchSelEl.addEventListener('change', () => {
          const isNew = exBatchSelEl.value === '__new_batch__';
          exBatchInputEl.classList.toggle('hidden', !isNew);
          exBatchInputEl.required = isNew;
        });

        const syncCourses = () => {
          const dept = depts.find((d) => d.name === deptEl.value);
          const courses = dept && dept.courses ? dept.courses : [];
          courseSelEl.innerHTML =
            courses.map((c) => `<option value="${this.esc(c.title)}">${this.esc(c.code)} — ${this.esc(c.title)}</option>`).join('') +
            `<option value="__custom__">Other / Custom Course...</option>`;
          syncStudyOptions();
        };
        const syncStudyOptions = () => {
          const isCustom = courseSelEl.value === '__custom__';
          courseInputEl.classList.toggle('hidden', !isCustom);
          courseInputEl.required = isCustom;
          const dept = depts.find((d) => d.name === deptEl.value);
          const course = dept && dept.courses ? dept.courses.find((c) => c.title === courseSelEl.value) : null;
          const opts = (course && course.studyOptions && course.studyOptions.length)
            ? course.studyOptions
            : ['Full-Time', 'Part-Time', 'Online', 'Hybrid'];
          studySelEl.innerHTML = opts.map((o) => `<option value="${this.esc(o)}">${this.esc(o)}</option>`).join('');
        };

        if (depts.length) deptEl.value = depts[0].name;
        syncCourses();
        deptEl.addEventListener('change', syncCourses);
        courseSelEl.addEventListener('change', syncStudyOptions);

        document.getElementById('createExamForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const chosenCourse = courseSelEl.value === '__custom__' ? courseInputEl.value : courseSelEl.value;
            const chosenBatch = exBatchSelEl.value === '__new_batch__' ? exBatchInputEl.value : exBatchSelEl.value;
            const res = await this.api('/api/examinations', {
              method: 'POST',
              body: {
                title: document.getElementById('exTitle').value,
                code: document.getElementById('exCode').value,
                department: deptEl.value,
                course: chosenCourse,
                studyOption: studySelEl.value,
                batchNumber: chosenBatch,
                examDate: document.getElementById('exDate').value,
                durationMinutes: Number(document.getElementById('exDur').value),
                totalMarks: Number(document.getElementById('exTotal').value),
                passingMarks: Number(document.getElementById('exPass').value),
                status: document.getElementById('exStatus').value,
                description: document.getElementById('exDesc').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.loadExaminations();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async toggleExamPublish(id, currentStatus) {
        try {
          const nextStatus = currentStatus === 'published' ? 'draft' : 'published';
          const res = await this.api(`/api/examinations/${id}`, {
            method: 'PUT',
            body: { status: nextStatus },
          });
          this.showToast(res.message, 'success');
          this.loadExaminations();
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      async deleteExam(id) {
        try {
          const res = await this.api(`/api/examinations/${id}`, { method: 'DELETE' });
          this.showToast(res.message, 'success');
          this.loadExaminations();
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      // ---------------- 4. QUESTION BANK (ADMIN — ALL COURSES & BATCH NUMBER WISE) ----------------
      async loadQuestions(selectedExamId = 'all', selectedCourse = '', selectedBatch = '') {
        this.setPageMeta('Academics', 'Question Bank');
        const [exData, depts] = await Promise.all([
          this.api('/api/examinations'),
          this.ensureDepartments(true),
        ]);
        const exams = exData.examinations;
        if (!exams.length) {
          document.getElementById('appContent').innerHTML = `<div class="card"><div class="empty-state"><i class="fa-solid fa-file-circle-question"></i><h3>No examinations found</h3><p>Create an examination first to add questions.</p></div></div>`;
          return;
        }
        const examId = selectedExamId || 'all';
        const currentExam = examId === 'all' ? null : (exams.find((ex) => ex._id === examId) || null);
        const params = new URLSearchParams();
        params.set('examId', examId);
        if (selectedCourse) params.set('course', selectedCourse);
        if (selectedBatch) params.set('batchNumber', selectedBatch);
        const qData = await this.api(`/api/questions?${params.toString()}`);
        const availableBatches = qData.batches || [];
        const availableCourses = qData.courses || [];

        const deptCourseTitles = new Set();
        const courseOptionsHtml = depts.map((d) => {
          const courses = d.courses || [];
          if (!courses.length) return '';
          courses.forEach((c) => deptCourseTitles.add(c.title));
          return `<optgroup label="${this.esc(d.name)} (${this.esc(d.code)})">
            ${courses.map((c) => `<option value="${this.esc(c.title)}" ${selectedCourse === c.title ? 'selected' : ''}>${this.esc(c.code)} — ${this.esc(c.title)}</option>`).join('')}
          </optgroup>`;
        }).join('');
        const extraCourses = availableCourses.filter((c) => !deptCourseTitles.has(c));
        const extraOptionsHtml = extraCourses.length
          ? `<optgroup label="Other / Exam Courses">
              ${extraCourses.map((c) => `<option value="${this.esc(c)}" ${selectedCourse === c ? 'selected' : ''}>${this.esc(c)}</option>`).join('')}
            </optgroup>`
          : '';

        // Group saved questions batch-number wise
        const batchGroups = new Map();
        for (const q of qData.questions) {
          const bKey = (q.batchNumber || 'BATCH-01').toUpperCase();
          if (!batchGroups.has(bKey)) batchGroups.set(bKey, []);
          batchGroups.get(bKey).push(q);
        }

        const renderBatchSections = () => {
          if (!qData.questions.length) {
            return `<div class="empty-state"><i class="fa-solid fa-circle-question"></i><p>No questions saved for the selected filters yet. Click "+ Add Question" to add questions by course and batch number.</p></div>`;
          }
          return Array.from(batchGroups.entries()).map(([batchNum, items]) => {
            const batchMarks = items.reduce((sum, it) => sum + (Number(it.marks) || 0), 0);
            const batchCourses = Array.from(new Set(items.map((it) => it.course || (it.examination && it.examination.course) || (currentExam && currentExam.course)).filter(Boolean))).join(', ');
            return `
              <div style="border:1px solid var(--border-color);border-radius:10px;padding:16px;margin-bottom:18px;background:#F7FAFD;">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;padding-bottom:12px;margin-bottom:14px;border-bottom:1px solid var(--border-color);">
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span class="badge badge-blue" style="font-size:12.5px;padding:5px 12px;"><i class="fa-solid fa-layer-group"></i> Batch: ${this.esc(batchNum)}</span>
                    ${batchCourses ? `<span class="badge badge-teal"><i class="fa-solid fa-book"></i> ${this.esc(batchCourses)}</span>` : ''}
                    <span class="badge badge-muted">${items.length} Question${items.length === 1 ? '' : 's'} &bull; ${batchMarks} Marks</span>
                  </div>
                  <button type="button" class="btn btn-outline btn-sm" data-add-to-batch="${this.esc(batchNum)}">
                    <i class="fa-solid fa-plus"></i> Add to ${this.esc(batchNum)}
                  </button>
                </div>
                ${items.map((q, idx) => {
                  const qExamCode = q.examination && q.examination.code ? q.examination.code : (currentExam ? currentExam.code : '');
                  return `
                  <div class="exam-question-card" style="background:var(--white);margin-bottom:10px;">
                    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;">
                      <div>
                        <span class="badge badge-blue">Q${idx + 1} &bull; ${this.esc(q.type.toUpperCase())}</span>
                        <span class="badge badge-green">${q.marks} Marks</span>
                        <span class="badge badge-orange">Batch ${this.esc(q.batchNumber || batchNum)}</span>
                        ${qExamCode ? `<span class="badge badge-muted">${this.esc(qExamCode)}</span>` : ''}
                        ${q.course ? `<span class="badge badge-teal">${this.esc(q.course)}</span>` : ''}
                        ${q.studyOption ? `<span class="badge badge-muted">${this.esc(q.studyOption)}</span>` : ''}
                        <span class="badge badge-muted">${this.esc(q.category)}</span>
                        <h4 style="margin-top:8px;font-size:14.5px;">${this.esc(q.prompt)}</h4>
                      </div>
                      <button type="button" class="btn btn-danger btn-sm" data-del-qid="${this.esc(q._id)}"><i class="fa-solid fa-trash"></i></button>
                    </div>
                    ${q.options && q.options.length ? `<ul style="margin:10px 0 6px 20px;font-size:13px;">${q.options.map((o) => `<li><strong>${this.esc(o.label)}:</strong> ${this.esc(o.text)}</li>`).join('')}</ul>` : ''}
                    <div style="font-size:12.5px;color:var(--green);margin-top:6px;"><strong>Answer Key:</strong> ${this.esc(q.correctAnswer)}</div>
                    ${q.attachmentFileId ? `<div style="margin-top:6px;"><button type="button" onclick="App.downloadWithAuth('/api/files/${this.esc(q.attachmentFileId)}', '${this.esc(q.attachmentName || 'attachment')}')" class="btn btn-outline btn-sm"><i class="fa-solid fa-paperclip"></i> ${this.esc(q.attachmentName || 'Attachment')}</button></div>` : ''}
                  </div>`;
                }).join('')}
              </div>`;
          }).join('');
        };

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="toolbar">
              <div class="toolbar-filters">
                <select id="qbExamSelect" class="form-control" style="max-width:270px;" title="Examination">
                  <option value="all" ${examId === 'all' ? 'selected' : ''}>All Examinations</option>
                  ${exams.map((ex) => `<option value="${this.esc(ex._id)}" ${ex._id === examId ? 'selected' : ''}>${this.esc(ex.code)} — ${this.esc(ex.title)}</option>`).join('')}
                </select>
                <select id="qbCourseFilter" class="form-control" style="max-width:260px;" title="Filter by Course">
                  <option value="">All Courses (${availableCourses.length})</option>
                  ${courseOptionsHtml}
                  ${extraOptionsHtml}
                </select>
                <select id="qbBatchFilter" class="form-control" style="max-width:170px;" title="Filter by Batch Number">
                  <option value="">All Batches</option>
                  ${availableBatches.map((b) => `<option value="${this.esc(b)}" ${selectedBatch === b ? 'selected' : ''}>Batch: ${this.esc(b)}</option>`).join('')}
                </select>
              </div>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button" class="btn btn-teal btn-sm" id="addBatchBtn"><i class="fa-solid fa-layer-group"></i> Add Batch</button>
                <button type="button" class="btn btn-primary btn-sm" id="addQuestionBtn"><i class="fa-solid fa-plus"></i> Add Question</button>
              </div>
            </div>

            ${renderBatchSections()}
          </div>
        `;

        document.getElementById('qbExamSelect').addEventListener('change', (e) => {
          this.loadQuestions(e.target.value, document.getElementById('qbCourseFilter').value, document.getElementById('qbBatchFilter').value);
        });
        document.getElementById('qbCourseFilter').addEventListener('change', (e) => {
          this.loadQuestions(examId, e.target.value, document.getElementById('qbBatchFilter').value);
        });
        document.getElementById('qbBatchFilter').addEventListener('change', (e) => {
          this.loadQuestions(examId, document.getElementById('qbCourseFilter').value, e.target.value);
        });
        document.getElementById('addBatchBtn').addEventListener('click', () => {
          this.openCreateBatchModal(() => this.loadQuestions(examId, selectedCourse, selectedBatch));
        });
        document.getElementById('addQuestionBtn').addEventListener('click', () => {
          this.openAddQuestionModal(examId, currentExam, availableBatches, selectedBatch, selectedCourse, exams);
        });
        document.querySelectorAll('[data-add-to-batch]').forEach((btn) => {
          btn.addEventListener('click', () => {
            this.openAddQuestionModal(examId, currentExam, availableBatches, btn.getAttribute('data-add-to-batch'), selectedCourse, exams);
          });
        });
        document.querySelectorAll('[data-del-qid]').forEach((btn) => {
          btn.addEventListener('click', () => {
            this.deleteQuestion(btn.getAttribute('data-del-qid'), examId, selectedCourse, selectedBatch);
          });
        });
      },

      async openAddQuestionModal(examId = 'all', examObj = null, existingBatches = [], presetBatch = '', presetCourse = '', examsList = null) {
        const [depts, exams, savedBatches] = await Promise.all([
          this.ensureDepartments(true),
          examsList ? Promise.resolve(examsList) : this.api('/api/examinations').then((r) => r.examinations || []),
          this.ensureBatches(true),
        ]);
        if (!exams.length) {
          this.showToast('Create an examination first before adding questions.', 'warning');
          return;
        }
        const initialExamId = examId && examId !== 'all' ? examId : exams[0]._id;
        const resolvedExam = examObj || exams.find((ex) => ex._id === initialExamId) || exams[0];
        const allBatchOptions = Array.from(
          new Set([
            ...savedBatches.filter((b) => b.status === 'active').map((b) => b.batchNumber),
            ...existingBatches,
            'BATCH-01',
          ].filter(Boolean))
        ).sort();
        const defaultBatch = presetBatch || (resolvedExam && resolvedExam.batchNumber) || allBatchOptions[0] || 'BATCH-01';

        this.showModal('Add Question (Course & Batch Wise)', `
          <form id="addQuestionForm">
            <div class="form-group">
              <label class="form-label">Examination</label>
              <select id="qExamSelect" class="form-control">
                ${exams.map((ex) => `<option value="${this.esc(ex._id)}" ${ex._id === initialExamId ? 'selected' : ''}>${this.esc(ex.code)} — ${this.esc(ex.title)}</option>`).join('')}
              </select>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Department</label>
                <select id="qDept" class="form-control">
                  <option value="">-- All Departments (All Courses) --</option>
                  ${depts.map((d) => `<option value="${this.esc(d.name)}">${this.esc(d.name)} (${this.esc(d.code)})</option>`).join('')}
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Selected Course</label>
                <select id="qCourseSelect" class="form-control"></select>
                <input id="qCourseCustom" class="form-control hidden" style="margin-top:6px;" placeholder="Enter course name" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Study Option</label>
                <select id="qStudyOption" class="form-control"></select>
              </div>
              <div class="form-group">
                <label class="form-label">Batch Number (for selected course)</label>
                <select id="qBatchSelect" class="form-control">
                  ${allBatchOptions.map((b) => `<option value="${this.esc(b)}" ${b === defaultBatch ? 'selected' : ''}>${this.esc(b)}</option>`).join('')}
                  <option value="__new_batch__">+ Add New Batch Number...</option>
                </select>
                <input id="qBatchNumber" class="form-control hidden" style="margin-top:6px;" placeholder="Enter new batch e.g. BATCH-04 or B-2026-A" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Question Type</label>
                <select id="qType" class="form-control">
                  <option value="mcq">Multiple Choice (MCQ)</option>
                  <option value="true_false">True / False</option>
                  <option value="short_answer">Short Answer</option>
                </select>
              </div>
              <div class="form-group"><label class="form-label">Marks</label><input id="qMarks" type="number" min="1" class="form-control" value="10" required /></div>
            </div>
            <div class="form-group"><label class="form-label">Category / Topic</label><input id="qCat" class="form-control" value="Core Concepts" /></div>
            <div class="form-group"><label class="form-label">Question Prompt</label><textarea id="qPrompt" class="form-control" required></textarea></div>
            <div id="mcqOptionsWrap">
              <div class="form-row">
                <div class="form-group"><label class="form-label">Option A</label><input id="optA" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Option B</label><input id="optB" class="form-control" /></div>
              </div>
              <div class="form-row">
                <div class="form-group"><label class="form-label">Option C</label><input id="optC" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Option D</label><input id="optD" class="form-control" /></div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Correct Answer (For MCQ enter A/B/C/D; for T/F enter True/False)</label>
              <input id="qCorrect" class="form-control" required />
            </div>
            <div class="form-group">
              <label class="form-label">Optional Reference File (PDF/Image, max 5MB)</label>
              <input id="qFile" type="file" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Save Question to Batch</button>
          </form>
        `, true);

        const qExamSelEl = document.getElementById('qExamSelect');
        const qDeptEl = document.getElementById('qDept');
        const qCourseSelEl = document.getElementById('qCourseSelect');
        const qCourseCustomEl = document.getElementById('qCourseCustom');
        const qStudyEl = document.getElementById('qStudyOption');

        const findMatchedDeptForCourse = (courseName) => {
          if (!courseName) return null;
          return depts.find((d) => (d.courses || []).some((c) => c.title.toLowerCase() === courseName.toLowerCase())) || null;
        };

        const syncQCourses = (preferCourse = '') => {
          const dept = depts.find((d) => d.name === qDeptEl.value);
          const courses = dept
            ? (dept.courses || []).map((c) => ({ ...c, deptCode: dept.code }))
            : depts.flatMap((d) => (d.courses || []).map((c) => ({ ...c, deptCode: d.code })));
          const uniqueCourses = [];
          const seen = new Set();
          for (const c of courses) {
            if (!seen.has(c.title)) {
              seen.add(c.title);
              uniqueCourses.push(c);
            }
          }
          if (preferCourse && !seen.has(preferCourse)) {
            uniqueCourses.unshift({ code: 'EXAM', deptCode: '', title: preferCourse, studyOptions: ['Full-Time', 'Part-Time', 'Online'] });
          }
          qCourseSelEl.innerHTML =
            uniqueCourses.map((c) => `<option value="${this.esc(c.title)}">${!dept && c.deptCode ? `[${this.esc(c.deptCode)}] ` : ''}${this.esc(c.code)} — ${this.esc(c.title)}</option>`).join('') +
            `<option value="__custom__">Other / Custom Course...</option>`;
          if (preferCourse) qCourseSelEl.value = preferCourse;
          syncQStudy();
        };

        const syncQStudy = () => {
          const isCustom = qCourseSelEl.value === '__custom__';
          qCourseCustomEl.classList.toggle('hidden', !isCustom);
          qCourseCustomEl.required = isCustom;
          const allCourses = depts.flatMap((d) => d.courses || []);
          const matched = allCourses.find((c) => c.title === qCourseSelEl.value);
          const opts = (matched && matched.studyOptions && matched.studyOptions.length)
            ? matched.studyOptions
            : ['Full-Time', 'Part-Time', 'Online', 'Hybrid'];
          qStudyEl.innerHTML = opts.map((o) => `<option value="${this.esc(o)}">${this.esc(o)}</option>`).join('');
          const selectedExam = exams.find((ex) => ex._id === qExamSelEl.value);
          if (selectedExam && selectedExam.studyOption && opts.includes(selectedExam.studyOption)) {
            qStudyEl.value = selectedExam.studyOption;
          }
        };

        const initialPreferredCourse = presetCourse || (examObj ? examObj.course : '');
        const matchedDept = initialPreferredCourse ? findMatchedDeptForCourse(initialPreferredCourse) : null;
        if (matchedDept) {
          qDeptEl.value = matchedDept.name;
        } else if (examObj && examObj.department) {
          qDeptEl.value = examObj.department;
        } else {
          qDeptEl.value = '';
        }
        syncQCourses(initialPreferredCourse);

        qExamSelEl.addEventListener('change', () => {
          const selEx = exams.find((ex) => ex._id === qExamSelEl.value);
          if (selEx && !presetCourse) {
            const d = findMatchedDeptForCourse(selEx.course);
            if (d) qDeptEl.value = d.name;
            else if (selEx.department) qDeptEl.value = selEx.department;
            syncQCourses(selEx.course);
          }
        });
        qDeptEl.addEventListener('change', () => syncQCourses(''));
        qCourseSelEl.addEventListener('change', syncQStudy);

        document.getElementById('qBatchSelect').addEventListener('change', (e) => {
          const isNew = e.target.value === '__new_batch__';
          const input = document.getElementById('qBatchNumber');
          input.classList.toggle('hidden', !isNew);
          input.required = isNew;
        });

        document.getElementById('qType').addEventListener('change', (e) => {
          document.getElementById('mcqOptionsWrap').classList.toggle('hidden', e.target.value !== 'mcq');
        });

        document.getElementById('addQuestionForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const targetExamId = qExamSelEl.value;
            let attachmentFileId = null;
            let attachmentName = '';
            const fileInput = document.getElementById('qFile');
            if (fileInput.files && fileInput.files[0]) {
              const up = await this.uploadFile(fileInput.files[0], 'question_file', targetExamId);
              attachmentFileId = up.file.id;
              attachmentName = up.file.filename;
            }
            const type = document.getElementById('qType').value;
            const selectedCourse = qCourseSelEl.value === '__custom__' ? qCourseCustomEl.value : qCourseSelEl.value;
            const batchSelVal = document.getElementById('qBatchSelect').value;
            const batchNumber = batchSelVal === '__new_batch__' ? document.getElementById('qBatchNumber').value : batchSelVal;
            const resolvedDept = qDeptEl.value || (findMatchedDeptForCourse(selectedCourse) ? findMatchedDeptForCourse(selectedCourse).name : '');
            const options =
              type === 'mcq'
                ? [
                    { label: 'A', text: document.getElementById('optA').value },
                    { label: 'B', text: document.getElementById('optB').value },
                    { label: 'C', text: document.getElementById('optC').value },
                    { label: 'D', text: document.getElementById('optD').value },
                  ].filter((o) => o.text.trim())
                : [];
            const res = await this.api(`/api/examinations/${targetExamId}/questions`, {
              method: 'POST',
              body: {
                department: resolvedDept,
                course: selectedCourse,
                studyOption: qStudyEl.value,
                batchNumber,
                type,
                category: document.getElementById('qCat').value,
                prompt: document.getElementById('qPrompt').value,
                marks: Number(document.getElementById('qMarks').value),
                options,
                correctAnswer: document.getElementById('qCorrect').value,
                attachmentFileId,
                attachmentName,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.loadQuestions(examId, presetCourse);
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async deleteQuestion(qid, examId = 'all', selectedCourse = '', selectedBatch = '') {
        try {
          await this.api(`/api/questions/${qid}`, { method: 'DELETE' });
          this.showToast('Question removed.', 'success');
          this.loadQuestions(examId, selectedCourse, selectedBatch);
        } catch (err) {
          this.showToast(err.message, 'error');
        }
      },

      // ---------------- 5. STUDENT EXAM TAKING ----------------
      async loadTakeExam(examId) {
        this.setPageMeta('Academics', 'Examination Session');
        const res = await this.api(`/api/examinations/${examId}/start`, { method: 'POST', body: {} });
        const { examination, submission, questions, remainingSeconds } = res;
        this.activeExamState = {
          examId,
          submissionId: submission._id,
          remainingSeconds,
          uploadedFiles: (submission.answerFiles || []).map((f) => f.fileId),
        };

        const existingMap = new Map((submission.answers || []).map((a) => [String(a.question), a]));

        document.getElementById('appContent').innerHTML = `
          <div class="exam-timer-bar">
            <div>
              <strong style="font-size:16px;">${this.esc(examination.code)} — ${this.esc(examination.title)}</strong>
              <div style="font-size:12px;opacity:0.88;">${this.esc(examination.instructions)}</div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
              <span class="status-pill pill-orange"><i class="fa-solid fa-clock"></i> <span id="examClock">--:--</span></span>
              <button type="button" class="btn btn-outline btn-sm" id="saveDraftBtn"><i class="fa-solid fa-floppy-disk"></i> Save Draft</button>
            </div>
          </div>

          <form id="examSubmitForm">
            ${questions.map((q, idx) => {
              const saved = existingMap.get(String(q._id)) || {};
              let inputHtml = '';
              if (q.type === 'mcq' || q.type === 'true_false') {
                inputHtml = (q.options || []).map((o) => `
                  <label class="option-choice">
                    <input type="radio" name="q_${this.esc(q._id)}" value="${this.esc(o.label)}" ${saved.selectedOption === o.label ? 'checked' : ''} />
                    <span><strong>${this.esc(o.label)}:</strong> ${this.esc(o.text)}</span>
                  </label>`).join('');
              } else {
                inputHtml = `<textarea class="form-control" name="q_text_${this.esc(q._id)}" placeholder="Write your answer clearly...">${this.esc(saved.answerText || '')}</textarea>`;
              }

              return `
                <div class="exam-question-card" data-qid="${this.esc(q._id)}" data-qtype="${this.esc(q.type)}">
                  <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                    <span class="badge badge-blue">Question ${idx + 1}</span>
                    <span class="badge badge-green">${q.marks} Marks</span>
                  </div>
                  <p style="font-weight:600;margin-bottom:10px;">${this.esc(q.prompt)}</p>
                  ${q.attachmentFileId ? `<div style="margin-bottom:10px;"><button type="button" onclick="App.downloadWithAuth('/api/files/${this.esc(q.attachmentFileId)}', '${this.esc(q.attachmentName || 'reference')}')" class="btn btn-outline btn-sm"><i class="fa-solid fa-download"></i> Reference Attachment</button></div>` : ''}
                  ${inputHtml}
                </div>`;
            }).join('')}

            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-upload"></i> Optional Answer Sheet Attachment</div></div>
              <div class="form-group">
                <label class="form-label">Attach supporting work (PDF, DOCX, TXT, PNG, JPG — max 5MB)</label>
                <input type="file" id="answerFileInput" class="form-control" />
              </div>
              <div id="uploadedFileStatus" style="font-size:12.5px;color:var(--green);"></div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;">
              <button type="button" class="btn btn-outline" onclick="App.navigate('examinations')">Back to List</button>
              <button type="submit" class="btn btn-success" id="finalSubmitExamBtn"><i class="fa-solid fa-paper-plane"></i> Final Submit Examination</button>
            </div>
          </form>
        `;

        const collectAnswers = () => {
          const items = [];
          document.querySelectorAll('.exam-question-card').forEach((card) => {
            const qid = card.getAttribute('data-qid');
            const qtype = card.getAttribute('data-qtype');
            if (qtype === 'short_answer') {
              const ta = card.querySelector(`textarea[name="q_text_${qid}"]`);
              items.push({ question: qid, answerText: ta ? ta.value : '', selectedOption: '' });
            } else {
              const checked = card.querySelector(`input[name="q_${qid}"]:checked`);
              items.push({ question: qid, selectedOption: checked ? checked.value : '', answerText: '' });
            }
          });
          return items;
        };

        const updateClock = () => {
          const clockEl = document.getElementById('examClock');
          if (!clockEl || !this.activeExamState) return;
          const secs = Math.max(0, this.activeExamState.remainingSeconds);
          const mins = Math.floor(secs / 60);
          const rem = secs % 60;
          clockEl.textContent = `${String(mins).padStart(2, '0')}:${String(rem).padStart(2, '0')}`;
          if (secs > 0) this.activeExamState.remainingSeconds -= 1;
        };
        updateClock();
        this.examTimerInterval = setInterval(updateClock, 1000);

        document.getElementById('answerFileInput').addEventListener('change', async (e) => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          try {
            const up = await this.uploadFile(file, 'answer_file', examId);
            this.activeExamState.uploadedFiles.push(up.file.id);
            document.getElementById('uploadedFileStatus').textContent = `Uploaded: ${up.file.filename}`;
            this.showToast('Answer attachment uploaded.', 'success');
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });

        document.getElementById('saveDraftBtn').addEventListener('click', async () => {
          try {
            await this.api(`/api/submissions/${submission._id}/draft`, {
              method: 'PUT',
              body: { answers: collectAnswers() },
            });
            this.showToast('Draft answers saved.', 'success');
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });

        document.getElementById('examSubmitForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('finalSubmitExamBtn');
          btn.disabled = true;
          try {
            const out = await this.api('/api/submissions', {
              method: 'POST',
              body: {
                examinationId: examId,
                answers: collectAnswers(),
                answerFiles: this.activeExamState.uploadedFiles,
              },
            });
            clearInterval(this.examTimerInterval);
            this.showToast(out.message, 'success');
            this.navigate('submissions');
          } catch (err) {
            this.showToast(err.message, 'error');
            btn.disabled = false;
          }
        });
      },

      // ---------------- 6. SUBMISSIONS & GRADING ----------------
