                </div>
                ${data.notifications.length ? data.notifications.map((n) => `
                  <div class="feed-item">
                    <div class="feed-icon"><i class="fa-solid fa-bell"></i></div>
                    <div>
                      <div style="font-weight:600;font-size:13px;">${this.esc(n.title)} ${!n.isRead ? '<span class="badge badge-orange">New</span>' : ''}</div>
                      <div style="font-size:12px;color:var(--text-muted);">${this.esc(n.message)}</div>
