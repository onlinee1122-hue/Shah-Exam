                  <div class="profile-meta-item"><span>Phone</span><span>${this.esc(p.phone || 'Not set')}</span></div>
                  <div class="profile-meta-item"><span>Program</span><span>${this.esc(p.program || '—')}</span></div>
                  <div class="profile-meta-item"><span>Enrolled</span><span>${this.fmtDate(p.enrollmentDate)}</span></div>
