        document.getElementById('appContent').innerHTML = `
          ${topSection}
          <div class="card">
            <div class="card-header">
              <div class="card-title"><i class="fa-solid fa-list-ul"></i> Transaction History</div>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Reference</th>
                    ${isAdmin ? '<th>Student</th>' : ''}
                    <th>Type</th><th>Category</th><th>Amount</th><th>Balance After</th><th>Description</th><th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  ${txRes.transactions.length ? txRes.transactions.map((t) => `
                    <tr>
                      <td><code style="font-size:12px;">${this.esc(t.reference)}</code></td>
                      ${isAdmin ? `<td>${this.esc(t.user ? t.user.name : '—')}</td>` : ''}
                      <td><span class="badge ${t.type === 'credit' ? 'badge-green' : 'badge-red'}">${this.esc(t.type.toUpperCase())}</span></td>
                      <td>${this.esc(t.category)}</td>
                      <td><strong>${t.type === 'credit' ? '+' : '-'}${this.fmtMoney(t.amount)}</strong></td>
                      <td>${this.fmtMoney(t.balanceAfter)}</td>
                      <td>${this.esc(t.description)}</td>
                      <td>${this.fmtDateTime(t.createdAt)}</td>
                    </tr>`).join('') : `<tr><td colspan="${isAdmin ? 8 : 7}" class="empty-state">No wallet transactions recorded.</td></tr>`}
                </tbody>
              </table>
            </div>
          </div>
        `;
      },

      async openWalletAdjustModal() {
        const stuRes = await this.api('/api/students?limit=50');
        this.showModal('Admin Wallet Adjustment', `
          <form id="walletAdjustForm">
            <div class="form-group">
              <label class="form-label">Select Student</label>
              <select id="waUser" class="form-control" required>
                ${stuRes.students.map((s) => `<option value="${this.esc(s.id)}">${this.esc(s.studentId)} — ${this.esc(s.name)} (Bal: ${this.fmtMoney(s.walletBalance)})</option>`).join('')}
              </select>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Transaction Type</label>
                <select id="waType" class="form-control">
                  <option value="credit">Credit (+)</option>
                  <option value="debit">Debit (-)</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Category</label>
                <select id="waCat" class="form-control">
                  <option value="scholarship">Scholarship</option>
                  <option value="reward">Academic Reward</option>
                  <option value="exam_fee">Examination Fee</option>
                  <option value="refund">Refund</option>
                  <option value="adjustment">Adjustment</option>
                </select>
              </div>
            </div>
            <div class="form-group"><label class="form-label">Amount (USD)</label><input id="waAmount" type="number" step="0.01" min="0.01" class="form-control" required /></div>
            <div class="form-group"><label class="form-label">Description</label><input id="waDesc" class="form-control" placeholder="Reason for adjustment..." required /></div>
            <button type="submit" class="btn btn-primary btn-block">Execute Atomic Transaction</button>
          </form>
        `);
        document.getElementById('walletAdjustForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/wallet/adjust', {
              method: 'POST',
              body: {
                userId: document.getElementById('waUser').value,
                type: document.getElementById('waType').value,
                category: document.getElementById('waCat').value,
                amount: Number(document.getElementById('waAmount').value),
                description: document.getElementById('waDesc').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.loadWallet();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      // ---------------- 9. INBOX & MESSAGING ----------------
      async loadMessages(folder = 'inbox', search = '') {
        this.setPageMeta(
          'Communication',
          'Inbox & Messaging',
          `<button class="btn btn-orange btn-sm" onclick="App.openComposeMessageModal()"><i class="fa-solid fa-pen-to-square"></i> Compose Message</button>`
        );
        const q = new URLSearchParams({ folder });
        if (search) q.set('q', search);
        const data = await this.api(`/api/messages?${q.toString()}`);

        document.getElementById('appContent').innerHTML = `
          <div class="card">
            <div class="toolbar">
              <div style="display:flex;gap:8px;">
                <button class="btn btn-sm ${folder === 'inbox' ? 'btn-primary' : 'btn-outline'}" id="tabInboxBtn"><i class="fa-solid fa-inbox"></i> Inbox (${data.unreadCount} unread)</button>
                <button class="btn btn-sm ${folder === 'sent' ? 'btn-primary' : 'btn-outline'}" id="tabSentBtn"><i class="fa-solid fa-paper-plane"></i> Sent</button>
              </div>
              <div class="toolbar-filters" style="justify-content:flex-end;">
                <input id="msgSearchInput" type="text" class="form-control" style="max-width:240px;" placeholder="Search messages..." value="${this.esc(search)}" />
                <button class="btn btn-outline btn-sm" id="msgSearchBtn"><i class="fa-solid fa-magnifying-glass"></i></button>
              </div>
            </div>

            ${data.messages.length ? data.messages.map((m) => `
              <div class="feed-item" style="${!m.isRead && folder === 'inbox' ? 'background:#F4F9FF;padding:12px;border-radius:8px;margin-bottom:6px;' : ''}">
                <div class="feed-icon"><i class="fa-solid ${m.isRead ? 'fa-envelope-open' : 'fa-envelope'}"></i></div>
                <div style="flex:1;">
                  <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;">
                    <strong>${this.esc(m.subject)} ${!m.isRead && folder === 'inbox' ? '<span class="badge badge-orange">Unread</span>' : ''}</strong>
                    <small style="color:var(--text-muted);">${this.fmtDateTime(m.createdAt)}</small>
                  </div>
                  <div style="font-size:12px;color:var(--theme-light);margin:2px 0 6px;">
                    ${folder === 'inbox'
                      ? `From: ${this.esc(m.sender ? m.sender.name : 'System')} (${this.esc(m.sender ? m.sender.email : '')})`
                      : `To: ${this.esc(m.recipient ? m.recipient.name : '')} (${this.esc(m.recipient ? m.recipient.email : '')})`}
                  </div>
                  <p style="font-size:13.5px;white-space:pre-wrap;">${this.esc(m.body)}</p>
                  <div style="margin-top:8px;display:flex;gap:8px;">
                    ${folder === 'inbox' && !m.isRead ? `<button class="btn btn-outline btn-sm" onclick="App.markMessageRead('${this.esc(m._id)}')"><i class="fa-solid fa-check"></i> Mark Read</button>` : ''}
                    <button class="btn btn-danger btn-sm" onclick="App.deleteMessage('${this.esc(m._id)}', '${this.esc(folder)}')"><i class="fa-solid fa-trash"></i> Delete</button>
                  </div>
                </div>
              </div>`).join('') : `<div class="empty-state"><i class="fa-solid fa-envelope-open"></i><p>No messages in ${this.esc(folder)}.</p></div>`}
          </div>
        `;

        document.getElementById('tabInboxBtn').addEventListener('click', () => this.loadMessages('inbox', search));
        document.getElementById('tabSentBtn').addEventListener('click', () => this.loadMessages('sent', search));
        document.getElementById('msgSearchBtn').addEventListener('click', () => {
          this.loadMessages(folder, document.getElementById('msgSearchInput').value);
        });
      },

      async openComposeMessageModal() {
        const recRes = await this.api('/api/messages/recipients');
        if (!recRes.recipients.length) {
          this.showToast('No active recipients available.', 'warning');
          return;
        }
        this.showModal('Compose New Message', `
          <form id="composeMsgForm">
            <div class="form-group">
              <label class="form-label">Recipient</label>
              <select id="msgRecipient" class="form-control" required>
                ${recRes.recipients.map((r) => `<option value="${this.esc(r._id)}">${this.esc(r.name)} (${this.esc(r.role.toUpperCase())} — ${this.esc(r.email)})</option>`).join('')}
              </select>
            </div>
            <div class="form-group"><label class="form-label">Subject</label><input id="msgSubject" class="form-control" required /></div>
            <div class="form-group"><label class="form-label">Message</label><textarea id="msgBody" class="form-control" required></textarea></div>
            <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-paper-plane"></i> Send Message</button>
          </form>
        `);
        document.getElementById('composeMsgForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/messages', {
              method: 'POST',
              body: {
                recipientId: document.getElementById('msgRecipient').value,
                subject: document.getElementById('msgSubject').value,
                body: document.getElementById('msgBody').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
            this.loadMessages('sent');
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      async markMessageRead(id) {
        await this.api(`/api/messages/${id}/read`, { method: 'PUT', body: {} });
        await this.refreshUserCounts();
        this.loadMessages('inbox');
      },

      async deleteMessage(id, folder) {
        await this.api(`/api/messages/${id}`, { method: 'DELETE' });
        await this.refreshUserCounts();
        this.showToast('Message removed.', 'success');
        this.loadMessages(folder);
      },

      // ---------------- 10. NOTIFICATIONS ----------------
      async loadNotifications() {
        const isAdmin = this.user.role === 'admin';
        this.setPageMeta(
          'Communication',
          'Notifications',
          `<div style="display:flex;gap:8px;">
            ${isAdmin ? `<button class="btn btn-orange btn-sm" onclick="App.openBroadcastModal()"><i class="fa-solid fa-bullhorn"></i> Broadcast</button>` : ''}
            <button class="btn btn-teal btn-sm" id="markAllNotifBtn"><i class="fa-solid fa-check-double"></i> Mark All Read</button>
          </div>`
        );

        const data = await this.api('/api/notifications');
        document.getElementById('appContent').innerHTML = `
          <div class="card">
            ${data.notifications.length ? data.notifications.map((n) => `
              <div class="feed-item" style="${!n.isRead ? 'background:#F4F9FF;padding:12px;border-radius:8px;margin-bottom:6px;' : ''}">
                <div class="feed-icon"><i class="fa-solid fa-bell"></i></div>
                <div style="flex:1;">
                  <div style="display:flex;justify-content:space-between;gap:8px;">
                    <strong>${this.esc(n.title)} ${!n.isRead ? '<span class="badge badge-orange">Unread</span>' : ''}</strong>
                    <small style="color:var(--text-muted);">${this.fmtDateTime(n.createdAt)}</small>
                  </div>
                  <p style="font-size:13px;color:var(--text-muted);margin:4px 0 8px;">${this.esc(n.message)}</p>
                  <div style="display:flex;gap:8px;">
                    ${!n.isRead ? `<button class="btn btn-outline btn-sm" onclick="App.markNotifRead('${this.esc(n._id)}')">Mark Read</button>` : ''}
                    ${n.linkView ? `<button class="btn btn-primary btn-sm" onclick="App.navigate('${this.esc(n.linkView)}')">Open Module</button>` : ''}
                  </div>
                </div>
              </div>`).join('') : `<div class="empty-state"><i class="fa-solid fa-bell-slash"></i><p>You have no notifications.</p></div>`}
          </div>
        `;

        document.getElementById('markAllNotifBtn').addEventListener('click', async () => {
          await this.api('/api/notifications/read-all', { method: 'PUT', body: {} });
          await this.refreshUserCounts();
          this.showToast('All notifications marked as read.', 'success');
          this.loadNotifications();
        });
      },

      async markNotifRead(id) {
        await this.api(`/api/notifications/${id}/read`, { method: 'PUT', body: {} });
        await this.refreshUserCounts();
        this.loadNotifications();
      },

      openBroadcastModal() {
        this.showModal('Broadcast Administrative Announcement', `
          <form id="broadcastForm">
            <div class="form-group"><label class="form-label">Announcement Title</label><input id="bcTitle" class="form-control" required /></div>
            <div class="form-group"><label class="form-label">Announcement Message</label><textarea id="bcMsg" class="form-control" required></textarea></div>
            <button type="submit" class="btn btn-orange btn-block"><i class="fa-solid fa-bullhorn"></i> Send to All Active Students</button>
          </form>
        `);
        document.getElementById('broadcastForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/notifications/broadcast', {
              method: 'POST',
              body: {
                title: document.getElementById('bcTitle').value,
                message: document.getElementById('bcMsg').value,
              },
            });
            this.closeModal();
            this.showToast(res.message, 'success');
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      // ---------------- 11. PROFILE & PASSWORD ----------------
      async loadProfile() {
        this.setPageMeta('Account', 'Profile & Security Settings');
        const data = await this.api('/api/profile');
        const u = data.user;
        const p = data.profile || {};
        const isStudent = u.role === 'student';

        const avatarMarkup = u.avatarBase64
          ? `<img src="${this.esc(u.avatarBase64)}" alt="Avatar" />`
          : this.esc(u.name.split(' ').map((x) => x[0]).slice(0, 2).join('').toUpperCase());

        document.getElementById('appContent').innerHTML = `
          <div class="grid-2">
            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-id-card"></i> Profile Details</div></div>
              <div style="text-align:center;margin-bottom:18px;">
                <div class="profile-avatar-lg">${avatarMarkup}</div>
                <label class="btn btn-outline btn-sm" style="cursor:pointer;">
                  <i class="fa-solid fa-camera"></i> Upload New Photo (Max 250KB)
                  <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" onchange="App.handleQuickAvatarUpload(this)" />
                </label>
              </div>
              <form id="profileUpdateForm">
                <div class="form-row">
                  <div class="form-group"><label class="form-label">Full Name</label><input id="pfName" class="form-control" value="${this.esc(u.name)}" required /></div>
                  <div class="form-group"><label class="form-label">Email</label><input class="form-control" value="${this.esc(u.email)}" disabled /></div>
                </div>
                ${isStudent ? `
                  <div class="form-row">
                    <div class="form-group"><label class="form-label">Student ID</label><input class="form-control" value="${this.esc(p.studentId)}" disabled /></div>
                    <div class="form-group"><label class="form-label">Phone</label><input id="pfPhone" class="form-control" value="${this.esc(p.phone || '')}" /></div>
                  </div>
                  <div class="form-row">
                    <div class="form-group"><label class="form-label">Department</label><input id="pfDept" class="form-control" value="${this.esc(p.department || '')}" /></div>
                    <div class="form-group"><label class="form-label">Program</label><input id="pfProgram" class="form-control" value="${this.esc(p.program || '')}" /></div>
                  </div>
                  <div class="form-group"><label class="form-label">Address</label><input id="pfAddress" class="form-control" value="${this.esc(p.address || '')}" /></div>
                  <div class="form-group"><label class="form-label">Bio</label><textarea id="pfBio" class="form-control">${this.esc(p.bio || '')}</textarea></div>
                ` : ''}
                <button type="submit" class="btn btn-primary btn-block">Save Profile Changes</button>
              </form>
            </div>

            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-key"></i> Change Password</div></div>
              <form id="changePasswordForm">
                <div class="form-group"><label class="form-label">Current Password</label><input id="cpCurrent" type="password" class="form-control" required /></div>
                <div class="form-group"><label class="form-label">New Password (min 8 chars, Uppercase, Lowercase, Digit)</label><input id="cpNew" type="password" class="form-control" required /></div>
                <div class="form-group"><label class="form-label">Confirm New Password</label><input id="cpConfirm" type="password" class="form-control" required /></div>
                <button type="submit" class="btn btn-orange btn-block">Update Password</button>
              </form>
            </div>
          </div>
        `;

        document.getElementById('profileUpdateForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const payload = { name: document.getElementById('pfName').value };
            if (isStudent) {
              payload.phone = document.getElementById('pfPhone').value;
              payload.department = document.getElementById('pfDept').value;
              payload.program = document.getElementById('pfProgram').value;
              payload.address = document.getElementById('pfAddress').value;
              payload.bio = document.getElementById('pfBio').value;
            }
            const res = await this.api('/api/profile', { method: 'PUT', body: payload });
            this.showToast(res.message, 'success');
            await this.refreshUserCounts();
            this.loadProfile();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });

        document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await this.api('/api/auth/change-password', {
              method: 'PUT',
              body: {
                currentPassword: document.getElementById('cpCurrent').value,
                newPassword: document.getElementById('cpNew').value,
                confirmPassword: document.getElementById('cpConfirm').value,
              },
            });
            this.showToast(res.message, 'success');
            e.target.reset();
          } catch (err) {
            this.showToast(err.message, 'error');
          }
        });
      },

      // ---------------- 12. REPORTS & ANALYTICS (ADMIN) ----------------
      async loadReports() {
        this.setPageMeta(
          'Analytics',
          'Reports & CSV Exports',
          `<div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" class="btn btn-success btn-sm" onclick="App.downloadWithAuth('/api/reports/students?format=csv', 'students_report.csv')"><i class="fa-solid fa-file-csv"></i> Students CSV</button>
            <button type="button" class="btn btn-orange btn-sm" onclick="App.downloadWithAuth('/api/reports/examinations?format=csv', 'examinations_report.csv')"><i class="fa-solid fa-file-csv"></i> Exams CSV</button>
            <button type="button" class="btn btn-teal btn-sm" onclick="App.downloadWithAuth('/api/reports/wallet?format=csv', 'wallet_transactions_report.csv')"><i class="fa-solid fa-file-csv"></i> Wallet CSV</button>
          </div>`
        );

        const [analyticsRes, stuRep, exRep] = await Promise.all([
          this.api('/api/reports/dashboard'),
          this.api('/api/reports/students'),
          this.api('/api/reports/examinations'),
        ]);
        const a = analyticsRes.analytics;

        document.getElementById('appContent').innerHTML = `
          <div class="grid-3">
            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-pie"></i> Students by Department</div></div>
              <div class="chart-box"><canvas id="repDeptChart"></canvas></div>
            </div>
            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-bar"></i> Grade Distribution</div></div>
              <div class="chart-box"><canvas id="repGradeChart"></canvas></div>
            </div>
            <div class="card">
              <div class="card-header"><div class="card-title"><i class="fa-solid fa-coins"></i> Wallet Categories ($)</div></div>
              <div class="chart-box"><canvas id="repWalletChart"></canvas></div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <div class="card-title"><i class="fa-solid fa-table"></i> Examination Summary Report</div>
              <button type="button" class="btn btn-outline btn-sm" onclick="App.downloadWithAuth('/api/reports/examinations?format=csv', 'examinations_report.csv')"><i class="fa-solid fa-download"></i> Export CSV</button>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Code</th><th>Title</th><th>Course</th><th>Status</th><th>Submissions</th><th>Avg Score</th><th>Pass Rate</th></tr></thead>
                <tbody>
                  ${exRep.rows.map((r) => `
                    <tr>
                      <td><strong>${this.esc(r.code)}</strong></td>
                      <td>${this.esc(r.title)}</td>
                      <td>${this.esc(r.course)}</td>
                      <td>${this.esc(r.status)}</td>
                      <td>${r.submissions}</td>
                      <td>${r.avgScore} / ${r.totalMarks}</td>
                      <td><strong>${r.passRate}%</strong></td>
                    </tr>`).join('')}
                </tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <div class="card-title"><i class="fa-solid fa-users"></i> Student Enrollment &amp; Wallet Report (${stuRep.rows.length})</div>
              <button type="button" class="btn btn-outline btn-sm" onclick="App.downloadWithAuth('/api/reports/students?format=csv', 'students_report.csv')"><i class="fa-solid fa-download"></i> Export CSV</button>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Student ID</th><th>Name</th><th>Department</th><th>Status</th><th>Wallet</th><th>Registered</th></tr></thead>
                <tbody>
                  ${stuRep.rows.map((r) => `
                    <tr>
                      <td><strong>${this.esc(r.studentId)}</strong></td>
                      <td>${this.esc(r.name)}</td>
                      <td>${this.esc(r.department)}</td>
                      <td><span class="badge ${r.status === 'active' ? 'badge-green' : 'badge-red'}">${this.esc(r.status)}</span></td>
                      <td>${this.fmtMoney(r.walletBalance)}</td>
                      <td>${this.fmtDate(r.registeredAt)}</td>
                    </tr>`).join('')}
                </tbody>
              </table>
            </div>
          </div>
        `;

        this.renderChart('repDeptChart', {
          type: 'doughnut',
          data: {
            labels: a.departments.map((d) => d.label),
            datasets: [{
              data: a.departments.map((d) => d.count),
              backgroundColor: ['#0F5298', '#27AE60', '#F39C12', '#33B89E', '#1665B5'],
            }],
          },
          options: { responsive: true, maintainAspectRatio: false },
        });

        this.renderChart('repGradeChart', {
          type: 'bar',
          data: {
            labels: a.gradeDistribution.length ? a.gradeDistribution.map((g) => g.grade) : ['N/A'],
            datasets: [{
              label: 'Students',
              data: a.gradeDistribution.length ? a.gradeDistribution.map((g) => g.count) : [0],
              backgroundColor: '#1665B5',
              borderRadius: 6,
            }],
          },
          options: { responsive: true, maintainAspectRatio: false },
        });

        this.renderChart('repWalletChart', {
          type: 'pie',
          data: {
            labels: a.walletCategories.map((w) => w.category),
            datasets: [{
              data: a.walletCategories.map((w) => w.totalAmount),
              backgroundColor: ['#27AE60', '#33B89E', '#F39C12', '#0F5298', '#D93025'],
            }],
          },
          options: { responsive: true, maintainAspectRatio: false },
        });
      },

      async logout() {
        try {
          await this.api('/api/auth/logout', { method: 'POST', body: {} });
        } catch (_err) {
          // ignore
        }
        this.user = null;
        this.authToken = '';
        this.showToast('Signed out cleanly.', 'success');
        this.showAuthScreen();
      },
    };

    document.addEventListener('DOMContentLoaded', () => App.init());
  </script>
</body>
</html>
