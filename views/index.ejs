          : [
              {
                label: 'Overview',
                items: [{ view: 'dashboard', icon: 'fa-gauge-high', text: 'Student Dashboard' }],
              },
              {
                label: 'Academics',
                items: [
                  { view: 'examinations', icon: 'fa-file-pen', text: 'Examinations' },
                  { view: 'submissions', icon: 'fa-list-check', text: 'My Submissions' },
                  { view: 'results', icon: 'fa-award', text: 'Published Results' },
                ],
              },
              {
                label: 'Wallet & Messages',
                items: [
                  { view: 'wallet', icon: 'fa-wallet', text: 'My Wallet' },
                  { view: 'messages', icon: 'fa-inbox', text: 'Inbox', badge: this.user.unreadMessages },
                  { view: 'notifications', icon: 'fa-bell', text: 'Notifications', badge: this.user.unreadNotifications },
                ],
              },
              {
                label: 'Account',
                items: [{ view: 'profile', icon: 'fa-id-card', text: 'Profile & Settings' }],
              },
            ];

