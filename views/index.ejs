                            <td><strong>${this.esc(ex.code)}</strong></td>
                            <td>${this.esc(ex.title)}</td>
                            <td>${this.fmtDate(ex.examDate)}</td>
                            <td>${ex.durationMinutes} min</td>
                            <td><button class="btn btn-primary btn-sm" onclick="App.navigate('take-exam', { examId: '${this.esc(ex._id)}' })">Open</button></td>
