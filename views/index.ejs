      setPageMeta(moduleName, pageTitle, actionHtml = '') {
        document.getElementById('crumbModule').textContent = moduleName;
        document.getElementById('crumbPage').textContent = pageTitle;
        document.getElementById('pageHeading').textContent = pageTitle;
        document.getElementById('subheaderActionSlot').innerHTML = actionHtml;
      },

      async navigate(view, params = {}) {
        if (this.examTimerInterval && view !== 'take-exam') {
          clearInterval(this.examTimerInterval);
          this.examTimerInterval = null;
        }
        this.currentView = view;
        this.destroyCharts();
        this.renderSidebar();

        const container = document.getElementById('appContent');
        container.innerHTML = `<div class="card" style="text-align:center;padding:48px;"><i class="fa-solid fa-spinner fa-spin" style="font-size:26px;color:var(--theme-light);"></i><p style="margin-top:10px;color:var(--text-muted);">Loading ${this.esc(view)}...</p></div>`;

        try {
          switch (view) {
            case 'dashboard':
              await this.loadDashboard();
              break;
            case 'students':
              await this.loadStudents();
              break;
            case 'departments':
              await this.loadDepartments();
              break;
            case 'batches':
              await this.loadBatches();
              break;
            case 'examinations':
              await this.loadExaminations();
              break;
            case 'questions':
              await this.loadQuestions(params.examId || '', params.course || '', params.batchNumber || '');
              break;
            case 'take-exam':
              await this.loadTakeExam(params.examId);
              break;
            case 'submissions':
              await this.loadSubmissions();
              break;
            case 'results':
              await this.loadResults();
              break;
            case 'wallet':
              await this.loadWallet();
              break;
            case 'messages':
              await this.loadMessages();
              break;
            case 'notifications':
              await this.loadNotifications();
              break;
            case 'profile':
              await this.loadProfile();
              break;
            case 'reports':
              await this.loadReports();
              break;
            default:
              await this.loadDashboard();
          }
        } catch (err) {
          container.innerHTML = `<div class="card"><div class="empty-state"><i class="fa-solid fa-circle-exclamation" style="color:var(--red);"></i><h3>Unable to load view</h3><p>${this.esc(err.message)}</p></div></div>`;
        }
      },

